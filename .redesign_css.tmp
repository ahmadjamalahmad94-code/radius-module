/* ─── إضافات النظام الموحّد لتبويب «خدماتي» (يونيو 2026) ─────────
   شريط علوي رفيع + زر تحديث واحد + عناوين مجموعات سطرية +
   بطاقة الخدمة المدفوعة (نفق تغيير IP) كزر. مسافات 16px موحّدة. */
.rh-inventory .rh-svc-bar{
  display:flex;align-items:center;justify-content:space-between;
  gap:12px;flex-wrap:wrap;margin:0 0 16px;
}
.rh-inventory .rh-svc-bar-title{
  display:inline-flex;align-items:center;gap:8px;
  font-size:15px;font-weight:900;color:#0F172A;
}
.rh-inventory .rh-svc-bar-title i{color:#6B5AED;font-size:14px}
.rh-inventory .rh-svc-refresh{
  display:inline-flex;align-items:center;gap:7px;
  min-height:34px;padding:0 13px;border-radius:9px;
  border:1px solid #E2E8F0;background:#fff;color:#475569;
  font-size:12.5px;font-weight:800;cursor:pointer;transition:all .14s;
}
.rh-inventory .rh-svc-refresh i{font-size:12px;transition:transform .4s}
.rh-inventory .rh-svc-refresh:hover{border-color:#CBD5E1;background:#F8FAFC;color:#334155}
.rh-inventory .rh-svc-refresh.is-spinning i{animation:rh-inv-refresh-spin .8s linear infinite}
@keyframes rh-inv-refresh-spin{to{transform:rotate(360deg)}}
/* عنوان مجموعة سطري خفيف مع خط فاصل رفيع. */
.rh-inventory .rh-svc-group-title{
  display:flex;align-items:center;gap:8px;
  margin:0 0 10px;font-size:12px;font-weight:900;
  letter-spacing:.02em;color:#64748B;
}
.rh-inventory .rh-svc-group-title i{color:#94A3B8;font-size:12px}
.rh-inventory .rh-svc-group-title::after{
  content:"";flex:1;height:1px;background:#EEF1F5;margin-inline-start:6px;
}
/* فجوة 16px موحّدة بين المجموعات. */
.rh-inventory .np-svc-grid{margin-bottom:16px}
.rh-inventory .np-svc-grid:last-of-type{margin-bottom:0}
/* بطاقة كزر (نفق تغيير IP) — نفس مظهر بطاقة الرابط تمامًا. */
.rh-inventory button.np-svc-card{
  font:inherit;text-align:start;width:100%;cursor:pointer;
}
/* بطاقة أداة: أظهر سهمًا باهتًا بنهاية السطر بدل نقطة الحالة. */
.rh-inventory .np-svc-card--tool .np-svc-arrow{
  display:inline-flex;align-items:center;justify-content:center;
  position:static;order:3;margin-inline-start:auto;
  width:auto;height:auto;background:none;color:#CBD5E1;font-size:11px;
  opacity:1;transform:none;
}
/* شارة «مدفوعة» صغيرة على بطاقة النفق. */
.rh-inventory .iptun-paid-mini{
  order:2;flex-shrink:0;
  font-size:9.5px;font-weight:900;letter-spacing:.02em;
  color:#b45309;background:#fffbeb;border:1px solid #fde68a;
  border-radius:999px;padding:1px 7px;line-height:1.6;
}
/* نقطة حالة الترخيص: قيد الطلب (كهرماني) / معلّق (أزرق). */
.rh-inventory .np-svc-status-dot.is-pending{background:#F59E0B;box-shadow:0 0 0 3px rgba(245,158,11,.18)}
.rh-inventory .np-svc-status-dot.is-suspended{background:#3B82F6;box-shadow:0 0 0 3px rgba(59,130,246,.18)}
