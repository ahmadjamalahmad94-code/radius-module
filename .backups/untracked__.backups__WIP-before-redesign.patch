+<script>
+(function(){
+  const modal = document.querySelector('[data-market-create-modal]');
+  const openButtons = document.querySelectorAll('[data-market-create-open]');
+  const closeButtons = document.querySelectorAll('[data-market-create-close]');
+  function openModal(){
+    if (!modal) return;
+    modal.hidden = false;
+    modal.classList.add('is-open');
+    document.body.style.overflow = 'hidden';
+    const first = modal.querySelector('select, input, button');
+    if (first) first.focus();
+  }
+  function closeModal(){
+    if (!modal) return;
+    modal.classList.remove('is-open');
+    modal.hidden = true;
+    document.body.style.overflow = '';
+  }
+  openButtons.forEach(btn => btn.addEventListener('click', openModal));
+  closeButtons.forEach(btn => btn.addEventListener('click', closeModal));
+  if (modal) {
+    modal.addEventListener('click', function(event){
+      if (event.target === modal) closeModal();
+    });
+    document.addEventListener('keydown', function(event){
+      if (event.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
+    });
+  }
+  const form = document.querySelector('[data-market-package-form]');
+  if (!form) return;
+  const plan = form.querySelector('[data-market-plan]');
+  const name = form.querySelector('[data-market-name]');
+  const price = form.querySelector('[data-market-price]');
+  function setUnitInput(hiddenName, baseValue, preferredUnits){
+    const hidden = form.querySelector('input[type="hidden"][name="' + hiddenName + '"]');
+    if (!hidden) return;
+    const wrap = hidden.closest('.ui-wrap');
+    const valueInput = wrap ? wrap.querySelector('.ui-value') : null;
+    const unitSelect = wrap ? wrap.querySelector('.ui-unit') : null;
+    const base = parseInt(baseValue || '0', 10) || 0;
+    hidden.value = String(base);
+    if (!valueInput || !unitSelect) return;
+    const units = preferredUnits || [];
+    for (const item of units) {
+      if (base > 0 && base % item.ratio === 0) {
+        unitSelect.value = item.unit;
+        valueInput.value = String(base / item.ratio);
+        valueInput.dispatchEvent(new Event('input', { bubbles:true }));
+        return;
+      }
+    }
+    unitSelect.value = units[0] ? units[0].unit : unitSelect.value;
+    valueInput.value = String(base);
+    valueInput.dispatchEvent(new Event('input', { bubbles:true }));
+  }
+  function setSpeedInput(hiddenName, kbps){
+    setUnitInput(hiddenName, kbps, [{unit:'Mbps', ratio:1024}, {unit:'kbps', ratio:1}]);
+  }
+  function setDurationInput(minutes){
+    setUnitInput('duration_minutes', minutes, [{unit:'day', ratio:1440}, {unit:'hr', ratio:60}, {unit:'min', ratio:1}]);
+  }
+  function speedLabel(kbps){
+    const value = parseInt(kbps || '0', 10) || 0;
+    if (value >= 1024 && value % 1024 === 0) return (value / 1024) + ' ميجا';
+    if (value >= 1024) return (value / 1024).toFixed(1).replace('.0','') + ' ميجا';
+    if (value > 0) return value + ' كيلو';
+    return 'حسب العرض';
+  }
+  function durationLabel(minutes){
+    const total = parseInt(minutes || '0', 10) || 0;
+    if (total >= 1440 && total % 1440 === 0) return (total / 1440) + ' يوم';
+    if (total >= 60 && total % 60 === 0) return (total / 60) + ' ساعات';
+    if (total >= 60) return (total / 60).toFixed(1).replace('.0','') + ' ساعة';
+    if (total > 0) return total + ' دقيقة';
+    return 'حسب العرض';
+  }
+  plan.addEventListener('change', function(){
+    const opt = plan.selectedOptions[0];
+    if (!opt || !opt.value) return;
+    setDurationInput(opt.dataset.duration || '0');
+    setSpeedInput('speed_down_kbps', opt.dataset.down || '0');
+    setSpeedInput('speed_up_kbps', opt.dataset.up || '0');
+    price.value = opt.dataset.price || '';
+    if (!name.value.trim()) {
+      name.value = durationLabel(opt.dataset.duration || '0') + ' / ' + speedLabel(opt.dataset.down || '0');
+    }
+  });
+})();
+</script>
