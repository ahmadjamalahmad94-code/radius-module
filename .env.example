# ─────────────────────────────────────────────────────────────────
# HobeRadius — Customer RADIUS Panel
# نسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل
# ─────────────────────────────────────────────────────────────────

# ── بيئة التشغيل ──────────────────────────────────────────────────
# dev | production
HOBERADIUS_ENV=production
FLASK_ENV=production
FLASK_DEBUG=0

# ── المفتاح السري للجلسات والـ tokens ─────────────────────────────
# أنشئه بـ: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=replace-with-a-long-random-flask-secret

# ── قاعدة البيانات (SQLite) ────────────────────────────────────────
HOBERADIUS_DB_PATH=/var/lib/hoberadius/hoberadius.db

# ── معرّف الـ Tenant (افتراضي 1 لكل نسخة مستقلة) ─────────────────
HOBERADIUS_TENANT_ID=1

# ── معرّف النسخة (يُرسَل في heartbeat للوحة التراخيص) ────────────
HOBERADIUS_INSTANCE_ID=customer-panel-01
HOBERADIUS_INSTANCE_FINGERPRINT=replace-with-hardware-fingerprint

# ── الرابط العام لهذه النسخة ──────────────────────────────────────
HOBERADIUS_PUBLIC_URL=https://radius.your-isp.com

# ── جسر لوحة التراخيص (Admin Bridge) ────────────────────────────
HOBERADIUS_ADMIN_BRIDGE_ENABLED=1
HOBERADIUS_ADMIN_BASE_URL=https://license.your-panel.com
# مفتاح الترخيص الصادر من لوحة التراخيص
HOBERADIUS_LICENSE_KEY=YOUR-LICENSE-KEY-HERE
# يمكن بديلاً استخدام INSTANCE_LICENSE_KEY بنفس القيمة
# INSTANCE_LICENSE_KEY=YOUR-LICENSE-KEY-HERE
# السر المشترك بين النسخة ولوحة التراخيص (HMAC-SHA256)
HOBERADIUS_ADMIN_SHARED_SECRET=replace-with-strong-shared-secret-min-32-chars
HOBERADIUS_ADMIN_TIMEOUT_SECONDS=10
HOBERADIUS_ADMIN_RETRY_COUNT=2
# مدة تزامن الترخيص (ثوانٍ) — يُستخدم من worker الداخلي
HOBERADIUS_ADMIN_BRIDGE_SYNC_INTERVAL_SECONDS=300

# ── توقيع الخادم (للتحقق من هوية لوحة التراخيص) ─────────────────
# HOBERADIUS_SERVER_FINGERPRINT=

# ── تشفير بيانات VPN (Fernet key) ────────────────────────────────
# أنشئه بـ: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HOBERADIUS_VPN_SECRET_KEY=replace-with-fernet-key

# ── خادم RADIUS (UDP) ────────────────────────────────────────────
# ملاحظة أمنية: لا تفتح المنافذ 1812/1813 للإنترنت — استخدم WireGuard فقط
HOBERADIUS_RADIUS_LISTEN_HOST=127.0.0.1
HOBERADIUS_RADIUS_AUTH_PORT=1812
HOBERADIUS_RADIUS_ACCT_PORT=1813
HOBERADIUS_RADIUS_SECRET=replace-with-radius-shared-secret

# ── WireGuard Mgmt (wg-mgmt) — واجهة الإدارة فقط ─────────────────
# تحذير أمني: wg-mgmt لا يحمل ترافيك بيانات أبدًا
# لا NAT، لا default route، لا IP forwarding على هذه الواجهة
# المنافذ المسموح بها فقط: 8728 (API) + 8729 (SSL) من 10.10.0.2
HOBERADIUS_WG_INTERFACE=wg-mgmt
HOBERADIUS_WG_SERVER_PUBKEY=replace-with-server-wireguard-public-key
HOBERADIUS_WG_SERVER_ENDPOINT=10.10.0.1:51820
HOBERADIUS_WG_SERVER_IP=10.10.0.2
HOBERADIUS_WG_SUBNET=10.10.0.0/24
HOBERADIUS_WG_PEERS_DIR=/etc/hoberadius/wg-mgmt-peers.d

# ── WireGuard Data (wg-data) — واجهة مستقلة لمشتركي VPN ─────────
# واجهة منفصلة كليًا عن wg-mgmt — عدادات وكوتا مستقلة
HOBERADIUS_WG_DATA_INTERFACE=wg-data
HOBERADIUS_WG_DATA_PEERS_DIR=/etc/hoberadius/wg-data-peers.d
HOBERADIUS_WG_DATA_SUBNET=10.100.0.0/24
HOBERADIUS_WG_DATA_SERVER_IP=10.100.0.1
# العنوان الذي يتصل به المشتركون من الخارج (IP:PORT)
HOBERADIUS_WG_DATA_ENDPOINT=your-server-ip:51821
HOBERADIUS_WG_DATA_KEY_FILE=/etc/wireguard/wg-data.key
HOBERADIUS_WG_DATA_DNS=1.1.1.1
HOBERADIUS_WG_DATA_LISTEN_PORT=51821

# ── CORS ───────────────────────────────────────────────────────────
# في الإنتاج: حدّد الأصول المسموح بها (فارغ = مغلق للمتصفحات)
# HOBERADIUS_CORS_ORIGINS=https://admin.your-isp.com

# ── الإصدار والبناء (اختياري — للـ health check) ─────────────────
# HOBERADIUS_VERSION=1.0.0
# HOBERADIUS_BUILD_SHA=git-sha

# ── إعدادات النسخ الاحتياطي (اختياري) ───────────────────────────
# HOBERADIUS_BACKUP_DIR=/var/backups/hoberadius
# HOBERADIUS_BACKUP_MAX_COUNT=10
# HOBERADIUS_BACKUP_RETENTION_DAYS=30

# ── اختياريات متقدمة ──────────────────────────────────────────────
# HOBERADIUS_NO_SEED=1               # تعطيل بذر البيانات التجريبية
# HOBERADIUS_NO_WORKER=1             # تعطيل workers الخلفية (للاختبار)
# HOBERADIUS_DEMO_SEED=0             # تعطيل بذر بيانات Demo في الإنتاج
# HOBERADIUS_NETWORK_OPS_ENABLED=0   # تعطيل مراقبة الشبكة (قيد التطوير)
