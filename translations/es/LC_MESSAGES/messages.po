#: app/templates/radius/docs_alerts.html:34
#: app/templates/radius/docs_alerts.html:116
msgid "جرد تنبيهات الإدارة"
msgstr "Inventario de alertas de administración"

#: app/templates/radius/docs_alerts.html:35
msgid "تنبيهات فصل الشبكة"
msgstr "Alertas de desconexión de red"

#: app/templates/radius/docs_alerts.html:36
msgid "قنوات SMS وواتساب"
