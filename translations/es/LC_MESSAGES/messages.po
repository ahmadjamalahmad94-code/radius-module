#: app/templates/admin/_admin_layout.html:555
#, python-format
msgid "الإصدار %(v)s"
msgstr "Versión %(v)s"

#: app/templates/admin/_admin_layout.html:556
msgid "حقوق النشر"
msgstr "Derechos de autor"

#: app/templates/admin/_admin_layout.html:583
msgid "أقسام الصفحة"
msgstr "Secciones de la página"

#: app/templates/admin/_admin_layout.html:584
msgid "ابدأ من القسم الأقرب لعملك. عند الانتقال لقسم مغلق سأفتحه لك تلقائيًا."
msgstr ""
"Empieza por la sección más cercana a tu trabajo. Cuando pases a una "
"sección bloqueada, la abriré automáticamente para ti."

#: app/templates/admin/_admin_layout.html:585
msgid "القسم"
msgstr "Sección"

#: app/templates/admin/_admin_layout.html:587
msgid "اسم الدخول الذي يستخدمه الشخص عند الاتصال أو تسجيل الدخول."
msgstr "El nombre de acceso que usa la persona al conectarse o iniciar sesión."

#: app/templates/admin/_admin_layout.html:588
msgid "اكتب كلمة مرور آمنة، واتركها فارغة إذا لم تكن تريد تغييرها."
msgstr "Introduzca una contraseña segura, o déjela vacía si no desea cambiarla."

#: app/templates/admin/_admin_layout.html:589
msgid "اكتب اسمًا واضحًا يظهر في القوائم ويسهّل البحث."
msgstr "Escribe un nombre claro que aparezca en las listas y facilite la búsqueda."

#: app/templates/admin/_admin_layout.html:590
msgid "رمز داخلي قصير يساعدك في الترتيب والبحث."
msgstr "Un código interno corto que te ayuda a ordenar y buscar."

#: app/templates/admin/_admin_layout.html:591
msgid "الاسم الظاهر للمستخدم داخل الواجهة."
msgstr "El nombre visible del usuario dentro de la interfaz."

#: app/templates/admin/_admin_layout.html:592
msgid "الاسم الحقيقي أو الوصفي لصاحب الحساب."
msgstr "El nombre real o descriptivo del titular de la cuenta."

#: app/templates/admin/_admin_layout.html:593
msgid "بريد للتواصل أو استلام التنبيهات عند الحاجة."
msgstr "Un correo para el contacto o para recibir alertas cuando sea necesario."

#: app/templates/admin/_admin_layout.html:594
msgid "رقم جوال واضح للتواصل السريع."
msgstr "Un número de móvil claro para contacto rápido."

#: app/templates/admin/_admin_layout.html:595
msgid "رقم بديل إن وجد."
msgstr "Número alternativo si lo hay."

#: app/templates/admin/_admin_layout.html:596
msgid "ملاحظات داخلية تساعدك عند المراجعة ولا تظهر عادة للمستفيد."
msgstr ""
"Notas internas que te ayudan en la revisión y normalmente no se muestran "
"al beneficiario."

#: app/templates/admin/_admin_layout.html:597
msgid "وصف قصير يوضّح الهدف من هذا العنصر."
msgstr "Una breve descripción que explica el propósito de este elemento."

#: app/templates/admin/_admin_layout.html:598
msgid "عند التعطيل يبقى العنصر محفوظًا لكنه لا يعمل في الاستخدام الجديد."
msgstr ""
"Cuando se deshabilita, el elemento se conserva pero no funciona en un uso"
" nuevo."

#: app/templates/admin/_admin_layout.html:599
msgid "اختر الحالة الحالية لهذا العنصر."
msgstr "Seleccione el estado actual de este elemento."

#: app/templates/admin/_admin_layout.html:600
msgid "اختر باقة الخدمة التي تحدد السرعة والحصة ومدة الاستخدام."
msgstr ""
"Elige el plan de servicio que define la velocidad, la cuota y la duración"
" de uso."

#: app/templates/admin/_admin_layout.html:601
msgid "اختر نوع الخدمة التي سيستخدمها الحساب على الشبكة."
msgstr "Elige el tipo de servicio que la cuenta usará en la red."

#: app/templates/admin/_admin_layout.html:602
msgid "اختر نوع الحساب حسب طريقة استخدامه."
msgstr "Elija el tipo de cuenta según su forma de uso."

#: app/templates/admin/_admin_layout.html:603
msgid "طريقة الدخول التي سيستخدمها المستفيد على الشبكة."
msgstr "El método de acceso que usará el beneficiario en la red."

#: app/templates/admin/_admin_layout.html:604
msgid "اسم مجموعة اختياري لتنظيم الحسابات المتشابهة."
msgstr "Un nombre de grupo opcional para organizar las cuentas similares."

#: app/templates/admin/_admin_layout.html:605
msgid "رقم المدير المسؤول إن كنت تستخدم توزيعًا إداريًا."
msgstr "El número del responsable si usas una distribución administrativa."

#: app/templates/admin/_admin_layout.html:606
msgid "مرجع اختياري يربط الحساب بسجل داخلي آخر."
msgstr "Una referencia opcional que vincula la cuenta con otro registro interno."

#: app/templates/admin/_admin_layout.html:607
msgid "اسم واضح لهذه الدفعة حتى تميّزها عند المراجعة."
msgstr "Un nombre claro para este lote para distinguirlo en la revisión."

#: app/templates/admin/_admin_layout.html:608
msgid "عدد العناصر التي سيتم إنشاؤها في هذه العملية."
msgstr "El número de elementos que se crearán en esta operación."

#: app/templates/admin/_admin_layout.html:609
msgid "عدد خانات اسم الدخول الذي سيتم توليده."
msgstr "El número de dígitos del usuario que se generará."

#: app/templates/admin/_admin_layout.html:610
msgid "عدد خانات كلمة المرور التي سيتم توليدها."
msgstr "El número de dígitos de la contraseña que se generarán."

#: app/templates/admin/_admin_layout.html:611
msgid "اختر نمط كلمة المرور حسب مستوى الأمان المطلوب."
msgstr "Elige el estilo de la contraseña según el nivel de seguridad requerido."

#: app/templates/admin/_admin_layout.html:612
msgid "نص اختياري يُضاف قبل أو بعد الاسم المولّد."
msgstr "Texto opcional añadido antes o después del nombre generado."

#: app/templates/admin/_admin_layout.html:613
msgid "استخدم 0 عندما تريد الاعتماد على قيمة الباقة الأساسية."
msgstr "Usa 0 cuando quieras basarte en el valor base del plan."

#: app/templates/admin/_admin_layout.html:614
msgid "الوحدة التي سيتم احتساب مدة البطاقة أو الحساب بها."
msgstr "La unidad con la que se calculará la duración del cupón o la cuenta."

#: app/templates/admin/_admin_layout.html:615
msgid "أقصى عدد أجهزة يمكنها استخدام نفس الحساب في نفس الوقت."
msgstr ""
"El número máximo de dispositivos que pueden usar la misma cuenta al mismo"
" tiempo."

#: app/templates/admin/_admin_layout.html:616
msgid "إجمالي الحصة بالميجابايت، و0 يعني بلا حد خاص."
msgstr "Cuota total en megabytes, y 0 significa sin límite específico."

#: app/templates/admin/_admin_layout.html:617
msgid "كمية التنزيل المتاحة يوميًا لهذا الحساب أو الباقة."
msgstr "Cuota de descarga disponible al día para esta cuenta o plan."

#: app/templates/admin/_admin_layout.html:618
msgid "كمية الرفع المتاحة يوميًا لهذا الحساب أو الباقة."
msgstr "Cuota de subida disponible al día para esta cuenta o plan."

#: app/templates/admin/_admin_layout.html:619
msgid "كمية التنزيل المتاحة خلال الشهر."
msgstr "Volumen de descarga disponible durante el mes."

#: app/templates/admin/_admin_layout.html:620
msgid "كمية الرفع المتاحة خلال الشهر."
msgstr "Volumen de subida disponible durante el mes."

#: app/templates/admin/_admin_layout.html:621
msgid "سرعة التنزيل بالكيلوبت، 1024 تعني تقريبًا 1 ميجابت."
msgstr ""
"Velocidad de descarga en kilobits; 1024 equivale aproximadamente a 1 "
"megabit."

#: app/templates/admin/_admin_layout.html:622
msgid "سرعة الرفع بالكيلوبت، 1024 تعني تقريبًا 1 ميجابت."
msgstr "Velocidad de subida en kbit; 1024 equivale aproximadamente a 1 Mbit."

#: app/templates/admin/_admin_layout.html:623
msgid "عنوان الجهاز أو الخادم داخل الشبكة."
msgstr "La dirección del dispositivo o servidor dentro de la red."

#: app/templates/admin/_admin_layout.html:624
msgid "اسم مختصر يظهر في السجلات والقوائم."
msgstr "Un nombre corto que aparece en los registros y las listas."

#: app/templates/admin/_admin_layout.html:625
msgid "المفتاح المشترك يجب أن يطابق إعداد جهاز الشبكة."
msgstr ""
"El secreto compartido debe coincidir con la configuración del dispositivo"
" de red."

#: app/templates/admin/_admin_layout.html:626
msgid "منفذ المصادقة القياسي غالبًا 1812."
msgstr "El puerto de autenticación estándar suele ser 1812."

#: app/templates/admin/_admin_layout.html:627
msgid "منفذ المحاسبة القياسي غالبًا 1813."
msgstr "El puerto de contabilidad estándar suele ser 1813."

#: app/templates/admin/_admin_layout.html:628
msgid "منفذ قطع الجلسة أو تحديثها غالبًا 3799."
msgstr "Puerto para desconectar o actualizar la sesión, normalmente 3799."

#: app/templates/admin/_admin_layout.html:629
msgid "منفذ واجهة الربط، غالبًا 8728 أو 8729 للاتصال الآمن."
msgstr ""
"El puerto de la interfaz de conexión, normalmente 8728 o 8729 para una "
"conexión segura."

#: app/templates/admin/_admin_layout.html:630
msgid "اسم مستخدم الراوتر المسموح له بإدارة الإعدادات."
msgstr ""
"El nombre de usuario del router con permiso para gestionar la "
"configuración."

#: app/templates/admin/_admin_layout.html:631
msgid "كلمة مرور الراوتر، احفظها بعناية."
msgstr "La contraseña del router, guárdela con cuidado."

#: app/templates/admin/_admin_layout.html:632
msgid "نص يستخدمه النظام لقراءة بيانات المراقبة من الجهاز."
msgstr ""
"Una cadena que el sistema usa para leer los datos de monitoreo del "
"dispositivo."

#: app/templates/admin/_admin_layout.html:633
msgid "الدور يحدد الصلاحيات التي يحصل عليها هذا المدير."
msgstr "El rol determina los permisos que recibe este gestor."

#: app/templates/admin/_admin_layout.html:634
msgid "اختر الصلاحيات المناسبة فقط لهذا الدور."
msgstr "Selecciona solo los permisos apropiados para este rol."

#: app/templates/admin/_admin_layout.html:635
msgid "رمز العملة المستخدم في العرض والتقارير."
msgstr "Código de moneda utilizado en la visualización y los informes."

#: app/templates/admin/_admin_layout.html:636
msgid "السعر المرجعي أو التجاري لهذا العنصر."
msgstr "El precio de referencia o de venta de este artículo."

#: app/templates/admin/_admin_layout.html:637
msgid "وسوم قصيرة للتنظيم، افصل بينها بفاصلة عند الحاجة."
msgstr ""
"Etiquetas cortas para organizar; sepáralas con una coma cuando sea "
"necesario."

#: app/templates/admin/_admin_layout.html:638
msgid "معرّف قصير مناسب للرابط، ويفضّل تثبيته بعد استخدامه."
msgstr ""
"Un identificador corto apto para el enlace; es preferible fijarlo una vez"
" usado."

#: app/templates/admin/_admin_layout.html:639
msgid "فئة الاشتراك تحدد الحدود الافتراضية لهذه الجهة."
msgstr ""
"La categoría de suscripción define los límites predeterminados de esta "
"entidad."

#: app/templates/admin/_admin_layout.html:640
msgid "أقصى عدد مستفيدين مسموح، و0 يعني استخدام حد الفئة."
msgstr ""
"Número máximo de beneficiarios permitido; 0 significa usar el límite de "
"la categoría."

#: app/templates/admin/_admin_layout.html:641
msgid "أقصى عدد أجهزة شبكة مسموح لهذه الجهة."
msgstr "Número máximo de dispositivos de red permitidos para esta entidad."

#: app/templates/admin/_admin_layout.html:642
msgid "عدد طلبات واجهة الربط المسموح بها في الدقيقة."
msgstr "El número de solicitudes de API permitidas por minuto."

#: app/templates/admin/_admin_layout.html:643
msgid "لغة الواجهة الافتراضية لهذه الجهة."
msgstr "Idioma de interfaz predeterminado para esta entidad."

#: app/templates/admin/_admin_layout.html:644
msgid "المنطقة الزمنية المستخدمة في التواريخ والتقارير."
msgstr "La zona horaria utilizada en las fechas y los informes."

#: app/templates/admin/_admin_layout.html:645
msgid "لون العلامة المستخدم في أجزاء من الواجهة."
msgstr "El color de marca usado en partes de la interfaz."

#: app/templates/admin/_admin_layout.html:646
msgid "رابط الشعار إن كنت تريد إظهاره للجهة."
msgstr "URL del logotipo si desea mostrarlo a la entidad."

