msgstr "Filtrar sesiones"

#: app/templates/radius/docs_sessions_report.html:126
msgid "جزء من الاسم يكفي — بحث مرن."
msgstr "Basta con parte del nombre — búsqueda flexible."

#: app/templates/radius/docs_sessions_report.html:129
msgid "تطبيق التصفية"
msgstr "Aplicar filtro"

#: app/templates/radius/docs_sessions_report.html:135
