#: app/templates/radius/anti_mac_clone.html:41
msgid "تشغيل ميزة منع استنساخ MAC"
msgstr "Enable MAC clone prevention feature"

#: app/templates/radius/anti_mac_clone.html:43
msgid "OFF افتراضيًّا — عند الإطفاء لا يتغيّر سلوك MAC-cookie المعتاد"
msgstr "OFF by default — when disabled, the usual MAC-cookie behavior is unchanged"

#: app/templates/radius/anti_mac_clone.html:55
msgid "Enforce — ارفض الدخول + ركل الجلسة عند الكشف"
msgstr "Enforce — deny login + kick the session on detection"

#: app/templates/radius/anti_mac_clone.html:58
msgid ""
"Step-up — ارفض أوّل محاولة، فإن أعاد المستخدم كتابة كلمة المرور من نفس "
"الجهاز الجديد ضمن النافذة فاسمح وأعد الربط"
msgstr ""
"Step-up — deny the first attempt; if the user re-enters the password from"
" the same new device within the window, allow and re-bind"

#: app/templates/radius/anti_mac_clone.html:61
msgid "Monitor — سجّل وأخبر فقط (بدون رفض)"
msgstr "Monitor — log and notify only (no denial)"

#: app/templates/radius/anti_mac_clone.html:67
msgid "نافذة الثقة الثانية (ث) — للنمط Step-up"
msgstr "Second trust window (s) — for Step-up mode"

#: app/templates/radius/anti_mac_clone.html:72
msgid "حدّ الثقة الأدنى لاتخاذ القرار"
msgstr "Minimum confidence threshold for decision-making"

#: app/templates/radius/anti_mac_clone.html:74
msgid "منخفض (حسّاس — قد يُكثر التنبيهات)"
msgstr "Low (sensitive — may generate many alerts)"

#: app/templates/radius/anti_mac_clone.html:75
msgid "متوسط (مُوصى به)"
msgstr "Medium (recommended)"

#: app/templates/radius/anti_mac_clone.html:76
msgid "عالٍ (متحفّظ — يفلت الحالات الضعيفة)"
msgstr "High (conservative — misses weak cases)"

#: app/templates/radius/anti_mac_clone.html:80
msgid "عدد الأحداث المعروضة"
msgstr "Number of displayed events"

#: app/templates/radius/anti_mac_clone.html:90
msgid ""
"حارس الجلسات المتزامنة (ترحال مستحيل: نفس MAC من راوتر/AP مختلف بآن واحد "
"= استنساخ)"
msgstr ""
"Concurrent session guard (impossible roaming: the same MAC from a "
"different router/AP at the same time = cloning)"

#: app/templates/radius/anti_mac_clone.html:97
msgid "ركل الجلسة الحيّة (CoA-Disconnect) عند كشف استنساخ — يتطلّب نمط Enforce"
msgstr ""
"Kick the live session (CoA-Disconnect) when cloning is detected — "
"requires Enforce mode"

#: app/templates/radius/anti_mac_clone.html:104
msgid ""
"إرسال تنبيه إدارة عبر تلجرام عند الكشف (يستخدم بوت التلجرام المُعدّ في "
"صفحة إشعارات الإدارة)"
msgstr ""
"Send an admin alert via Telegram on detection (uses the Telegram bot "
"configured on the admin notifications page)"

#: app/templates/radius/anti_mac_clone.html:111
#: app/templates/radius/network_policy_form.html:170
msgid "نطاق التطبيق"
msgstr "Application scope"

#: app/templates/radius/anti_mac_clone.html:113
msgid "كل المشتركين والبطاقات"
msgstr "All subscribers and cards"

#: app/templates/radius/anti_mac_clone.html:114
msgid "عروض/باقات محدّدة"
msgstr "Specific offers/packages"

#: app/templates/radius/anti_mac_clone.html:115
msgid "مجموعات مشتركين محدّدة"
msgstr "Specific subscriber groups"

#: app/templates/radius/anti_mac_clone.html:124
msgid "العروض/الباقات"
msgstr "Offers/Plans"

#: app/templates/radius/anti_mac_clone.html:152
msgid ""
"تحفّظ مهم: جهازان من نفس الطراز قد يتشابهان في الإشارات (false positive)."
" استخدم النمط Monitor قبل Enforce حتى تطمئنّ للنطاق. تجوال نفس الجهاز بين"
" الـAP الواحد لا يُحسب استنساخًا. تجديد DHCP لنفس الجهاز بنفس MAC/IP ليس "
"استنساخًا. عناوين MAC العشوائية في كل اتصال جديد ليست استنساخًا أصلًا."
msgstr ""
"Important caveat: two devices of the same model may have similar "
"signatures (false positive). Use Monitor mode before Enforce until you "
"are confident in the scope. The same device roaming between APs is not "
"counted as cloning. A DHCP renewal for the same device with the same "
"MAC/IP is not cloning. Random MAC addresses on every new connection are "
"not cloning at all."

#: app/templates/radius/anti_mac_clone.html:170
msgid "OS"
msgstr "OS"

