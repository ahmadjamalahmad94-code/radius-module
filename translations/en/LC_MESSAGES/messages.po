msgstr ""
"The panel verifies the secret, then looks up the subscriber/card and "
"applies the series of policy checks."

#: app/templates/radius/docs_radius.html:124
msgid "اللوحة تردّ بـ"
msgstr "The panel responds with"

#: app/templates/radius/docs_radius.html:124
msgid "(قبول) أو"
msgstr "(accept) or"

#: app/templates/radius/docs_radius.html:124
msgid "(رفض) مع سبب."
