msgid "المراجعة:"
msgstr "Review:"

#: app/templates/radius/docs_finance_collection.html:60
msgid "قائمة الطلبات التي رفعت إثباتًا وتنتظر قرارك."
msgstr "The list of requests that submitted proof and await your decision."

