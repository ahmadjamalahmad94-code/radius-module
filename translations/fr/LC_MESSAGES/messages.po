#, python-format
msgid "استخدام %(label)s مرتفع جدًا (%(v)s%%)."
msgstr "L'utilisation de %(label)s est très élevée (%(v)s%%)."

#: app/radius/services/dashboard_metrics.py:255
#, python-format
msgid "استخدام %(label)s مرتفع (%(v)s%%)."
msgstr "L'utilisation de %(label)s est élevée (%(v)s%%)."

#: app/radius/services/dashboard_metrics.py:265
#, python-format
msgid "%(n)s مشترك ينتهي اشتراكه خلال 3 أيام."
msgstr "%(n)s abonné(s) dont l'abonnement expire dans 3 jours."

#: app/radius/services/dashboard_metrics.py:270
#, python-format
msgid "%(n)s مشترك انتهى اشتراكه — جدّد أو احذف."
msgstr "%(n)s abonné(s) dont l'abonnement a expiré — renouvelez ou supprimez."

#: app/radius/services/dashboard_metrics.py:277
msgid "لا توجد كروت متاحة — وَلِّد دفعة جديدة."
msgstr "Aucun coupon disponible — générez un nouveau lot."

#: app/radius/services/dashboard_metrics.py:280
#, python-format
msgid "الكروت المتاحة منخفضة (%(n)s) — جدّد المخزون."
msgstr "Les coupons disponibles sont faibles (%(n)s) — réapprovisionnez le stock."

#: app/radius/services/dashboard_metrics.py:285
msgid "لا توجد باقات بعد — أنشئ أول باقة."
msgstr "Aucun forfait pour l'instant — créez le premier forfait."

#: app/radius/services/dashboard_metrics.py:290
msgid "لا توجد أجهزة NAS مُسجَّلة — أضِف router/AP."
msgstr "Aucun équipement NAS enregistré — ajoutez un routeur/AP."

