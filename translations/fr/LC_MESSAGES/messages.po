#: app/templates/radius/docs_reports_overview.html:365
msgid "نطاق التاريخ"
msgstr "Plage de dates"

#: app/templates/radius/docs_reports_overview.html:366
msgid "«من تاريخ»"
msgstr "« À partir du »"

#: app/templates/radius/docs_reports_overview.html:366
