msgstr ""
"Il conserve la valeur des jours restants et les convertit en plus de "
"jours selon le prix d'offre inférieur."

msgid "يحتاج إعداد خادم الربط مسبقًا."
msgstr "Nécessite la configuration préalable du serveur de liaison."

msgid "يحتاج المتغيّر"
msgstr "La variable est requise"

msgid "يحتاج انتباه"
msgstr "Nécessite une attention"

msgid "يحتاج تأكيدًا"
msgstr "Nécessite une confirmation"

msgid "يحتفظ بالكوتا المتبقية عند إعادة التفعيل."
msgstr "Conserve le quota restant lors de la réactivation."

msgid "يحدد ما الذي يُحاسَب عليه العرض: وقت أم حصة أم الاثنان."
msgstr "Détermine ce sur quoi l'offre est facturée : temps, quota ou les deux."

msgid "يحدد نوع الخدمة الذي ينطبق عليه العرض."
msgstr "Définit le type de service auquel l'offre s'applique."

