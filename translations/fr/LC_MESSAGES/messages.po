msgstr ""
"Supprime le forfait et tous ses coupons après une fenêtre de confirmation"
" —"

msgid "يحذف فقط القوالب التي أنشأتها الاختبارات تلقائيًا — لا يمسّ قوالبك."
msgstr ""
"Supprime uniquement les modèles créés automatiquement par les tests — il "
"ne touche pas à vos modèles."

msgid "يحذف فقط القوالب التي أنشأتها الاختبارات تلقائيًا."
msgstr "Supprime uniquement les modèles créés automatiquement par les tests."

msgid "يحذف كل السطور على الراوتر اللي تحمل علامة"
msgstr "Supprime toutes les lignes du routeur portant la marque"

msgid "يحذف هذا الإجراء كل سجلات تجهيز الراوترات."
msgstr ""
"Cette action supprime tous les enregistrements de provisionnement des "
"routeurs."

msgid "يحفظ MAC أول جهاز يتصل ويربط البطاقة عليه."
msgstr ""
"Enregistre la MAC du premier appareil qui se connecte et lui lie le "
"coupon."

msgid "يحفظ الشريحة ثم يعرض جمهورها — لا يتم إرسال أي رسالة."
msgstr ""
"Il enregistre le segment puis affiche son audience — aucun message n'est "
"envoyé."

msgid "يحمي واجهة المتجر من الاستدعاء الخارجي."
msgstr "Protège l'interface de la boutique contre les appels externes."

msgid "يحوّل البطاقة لحالة «طالب» تلقائيًا عند أول اتصال."
msgstr ""
"Convertit le coupon en état « demandeur » automatiquement à la première "
"connexion."

msgid "يختار الزبون باقة ويضغط"
msgstr "Le client choisit un forfait et clique"

msgid "يختفي القسم تمامًا فلا يرى إلا أقسامه."
msgstr ""
"La section disparaît complètement, de sorte qu'ils ne voient que leurs "
"propres sections."

msgid "يخصم المبلغ، ويمرّ عبر"
msgstr "Déduit le montant, et passe par"

msgid "يخفي الفاتورة عن المشترك."
msgstr "Masque la facture à l'abonné."

msgid "يدوي"
msgstr "Manuel"

msgid "يدويّة"
msgstr "Manuel"

msgid "يرجّع الحزم المؤرشفة المحددة للعمل."
msgstr "Réactive les paquets archivés sélectionnés."

msgid ""
"يرسل أمر فصل إلى خدمة المصادقة. إذا لم تكن الجلسة متصلة، لن يظهر زر مفيد "
"هنا."
msgstr ""
"Envoie une commande de déconnexion au service d'authentification. Si la "
"session n'est pas connectée, aucun bouton utile n'apparaît ici."

msgid ""
"يرسل أمر فصل فوري للجلسة بعد نافذة تأكيد «قطع جلسة …؟» — الكرت ينفصل لكنه"
" يقدر يسجّل دخولًا من جديد ما دامت صلاحيته سارية."
msgstr ""
"Envoie une commande de déconnexion immédiate de la session après une "
"boîte de confirmation « Déconnecter la session … ? » — le coupon est "
"déconnecté mais peut se reconnecter tant qu'il reste valide."

msgid "يرسل الرد"
msgstr "Envoie la réponse"

msgid "يرسل المشترك كلمة بسيطة، فيرد البوت فورًا ببياناته الحقيقية."
msgstr ""
"L'abonné envoie un mot simple, et le bot répond instantanément avec ses "
"données réelles."

msgid ""
"يرسل النظام إشعارات الأحداث إلى هذا الرابط. اتركه فارغًا إذا لا تستخدم "
"تكاملًا خارجيًا."
msgstr ""
"Le système envoie les notifications d'événements à cette URL. Laissez-la "
"vide si vous n'utilisez pas d'intégration externe."

msgid "يرسل رسالة جاهزة للتأكّد من وصول التنبيهات قبل أي عطل حقيقي."
msgstr ""
"Envoie un message prêt à l'emploi pour confirmer que les alertes arrivent"
" avant toute panne réelle."

msgid "يرسل كلمة"
msgstr "Envoie un mot"

msgid "يرى الموظف القسم بقفل فيعرف أنه موجود خارج صلاحيته."
msgstr ""
"L'employé voit la section verrouillée, il sait donc qu'elle existe mais "
"qu'elle dépasse ses droits."

msgid "يزيد الرصيد،"
msgstr "augmente le solde,"

msgid "يزيد رصيده/مدته. أكثر قيد رح تشوفه."
msgstr "Augmente son solde/sa durée. L'écriture la plus fréquente que vous verrez."

msgid "يسار إلى يمين / طويل"
msgstr "Gauche à droite / haut"

msgid "يسار إلى يمين / عريض"
msgstr "Gauche à droite / large"

msgid "يساعد فرق الصيانة على الوصول للموقع."
msgstr "Aide les équipes de maintenance à atteindre le site."

msgid "يستخدم الإعدادات المحفوظة لهذه القناة. احفظ التغييرات أولًا قبل الاختبار."
msgstr ""
"Il utilise les paramètres enregistrés pour ce canal. Enregistrez d'abord "
"les modifications avant de tester."

msgid "يستخدم عندما يكون السعر مساويًا أو لا تتوفر بيانات كافية للتعويض."
msgstr ""
"Utilisé lorsque le prix est égal ou qu'il n'y a pas assez de données pour"
" la compensation."

msgid "يستعملها العميل للدخول إلى"
msgstr "Le client l'utilise pour se connecter à"

msgid "يستعيد الوقت المتبقي"
msgstr "Restaure le temps restant"

msgid "يسرد حتى 50 مشتركًا عليهم أكبر مديونيات، بأعمدة:"
msgstr ""
"Liste jusqu'à 50 abonnés ayant les plus grandes dettes, avec les colonnes"
" :"

msgid "يسمح بإقراض وقت/كوتا مؤقتًا للمشترك."
msgstr "Permet de prêter temporairement du temps/quota à l'abonné."

msgid "يسمح بتجاوز السرعة مؤقتًا فوق الحد (Burst)."
msgstr "Permet de dépasser temporairement la vitesse au-delà de la limite (Burst)."

msgid "يسمح بتنفيذ عمليات البيع ضمن الحزم المسموحة فقط."
msgstr "Permet d'effectuer des ventes uniquement dans les forfaits autorisés."

msgid "يسمح بتنفيذ عمليات البيع ضمن الحزم المسموحة له فقط."
msgstr ""
"Autorise les opérations de vente uniquement dans les forfaits qui lui "
"sont permis."

msgid "يسمح لسرعة المشترك بتجاوز سرعة العرض."
msgstr "Permet à la vitesse de l'abonné de dépasser celle de l'offre."

msgid "يسمح للمشترك بإرسال طلب تغيير عرض للمشغّل."
msgstr ""
"Permet à l'abonné d'envoyer une demande de changement d'offre à "
"l'opérateur."

msgid "يسمح للمشترك بتبديل عرضه بنفسه."
msgstr "Permet à l'abonné de changer son offre lui-même."

msgid "يسمح للموزع برؤية الحزم المربوطة به ومتابعة حالتها — الأساس لأي عمل."
msgstr ""
"Permet au distributeur de voir les forfaits qui lui sont rattachés et de "
"suivre leur état — la base de tout travail."

msgid "يسمح للموزع برؤية الحزم المرتبطة به ومتابعة حالتها."
msgstr ""
"Permet au distributeur de voir les forfaits qui lui sont associés et de "
"suivre leur état."

msgid "يشحن محفظته: يُدخل"
msgstr "Recharge son portefeuille : saisit"

msgid ""
"يشغّل روابط متجر البطاقات الإلكترونية في صفحات الهوت سبوت — يُضبط مرة "
"واحدة ويُستخدم في كل التصاميم تلقائيًا."
msgstr ""
"Active les liens de la boutique de coupons électroniques sur les pages "
"hotspot — défini une seule fois et utilisé automatiquement dans tous les "
"modèles."

msgid "يصله الرد"
msgstr "Reçoit la réponse"

msgid ""
"يضيف الرصيد محليًا فورًا ويُسجَّل في سجل الحركات وسجل التدقيق. مخصّص "
"لمشغّل لوحة التراخيص أو المزوّد."
msgstr ""
"Ajoute le solde localement immédiatement et l'enregistre dans le journal "
"des mouvements et le journal d'audit. Destiné à l'opérateur du panneau de"
" licences ou au fournisseur."

msgid "يضيف المبلغ للرصيد ويُنتج قيدًا. يحتاج صلاحية الشحن."
msgstr ""
"Ajoute le montant au solde et génère une écriture. Nécessite "
"l'autorisation de recharge."

msgid "يضيف رقم الحزمة لبداية الاسم لتعرف مصدر أي بطاقة فورًا."
msgstr ""
"Ajoute le numéro de lot au début du nom pour identifier instantanément la"
" source de tout coupon."

msgid "يضيف عنوان المشترك لقائمة Address-List في الراوتر."
msgstr "Ajoute l'adresse de l'abonné à l'Address-List du routeur."

msgid "يضيف نصًا ثابتًا لكل أسماء البطاقات لتمييز الحزمة."
msgstr ""
"Ajoute un texte fixe à tous les noms de coupons pour distinguer le "
"forfait."

msgid "يطابق المفتاح على جهاز الشبكة نفسه."
msgstr "Correspond à la clé sur le périphérique réseau lui-même."

msgid "يطابق ويجهّز الرد"
msgstr "Fait correspondre et prépare la réponse"

msgid "يطلع لك تلميح فيه الفترة وقيمتها الدقيقة."
msgstr "Une infobulle apparaît indiquant la période et sa valeur exacte."

msgid "يظهر"
msgstr "S'affiche"

msgid "يظهر أسفل الشاشة"
msgstr "Apparaît en bas de l'écran"

msgid "يظهر الردّ في سجلّ المحادثة باسم الإداري الحالي."
msgstr ""
"La réponse apparaît dans l'historique de la conversation au nom de "
"l'administrateur actuel."

msgid ""
"يظهر بعد 60 ثانية من المحاولة. استخدمه فقط إذا كنت متأكّداً أن الاتصال "
"يعمل لكن الفحص التلقائي لا يكتشفه."
msgstr ""
"Apparaît 60 secondes après la tentative. Ne l'utilisez que si vous êtes "
"certain que la connexion fonctionne mais que le contrôle automatique ne "
"la détecte pas."

msgid "يظهر رابط «إعادة ضبط» متى كان هناك فلتر نشط — يمسح الكل بنقرة."
msgstr ""
"Un lien « Réinitialiser » apparaît dès qu'un filtre est actif — il efface"
" tout en un clic."

msgid "يظهر في القائمة والسجلات."
msgstr "Apparaît dans la liste et les journaux."

msgid "يظهر في القائمة وعلى تقارير المبيعات."
msgstr "Apparaît dans la liste et sur les rapports de ventes."

msgid ""
"يظهر في ترويسة الموقع وصفحات الطباعة والفواتير — هذا اسم شركتك أمام "
"موظفيك وعملائك."
msgstr ""
"Apparaît dans l'en-tête du site, les pages d'impression et les factures ;"
" c'est le nom de votre entreprise auprès de vos employés et clients."

msgid "يظهر في غرفة الطباعة وصفحة الإحصائيات فقط — لا يُطبع على البطاقة."
msgstr ""
"Apparaît uniquement dans la salle d'impression et la page des "
"statistiques — il n'est pas imprimé sur la carte."

msgid "يظهر في قائمة السياسات المحفوظة. يُولَّد تلقائيًا إن تُرك فارغًا."
msgstr ""
"Apparaît dans la liste des politiques enregistrées. Généré "
"automatiquement si laissé vide."

msgid "يظهر في لوحة المتابعة وتُفعَّل تنبيهاته تلقائيًا."
msgstr ""
"Apparaît sur le tableau de suivi et ses alertes sont activées "
"automatiquement."

msgid "يظهر لما يبقى 10 كروت أو أقل، أو لما تقترب حزمة معينة من النفاد."
msgstr ""
"Apparaît lorsqu'il reste 10 cartes ou moins, ou lorsqu'un lot donné est "
"sur le point d'être épuisé."

msgid ""
"يعتمد ذلك على بوت أنشأته أنت، وتنبيهات تفعّلها من «الإشعارات الحدثية» أو "
"من صفحة كل جهاز."
msgstr ""
"Cela dépend d'un bot que vous avez créé et des alertes que vous activez "
"depuis « Notifications d'événements » ou depuis la page de chaque "
"appareil."

msgid "يعرض تقارير عائلة «الشبكة والجلسات» لأنك داخل أحدها."
msgstr ""
"Affiche les rapports de la famille « Réseau et sessions » car vous vous "
"trouvez dans l'un d'eux."

msgid "يعرض جميع الباقات (هو المختار افتراضيًا)."
msgstr "Affiche tous les forfaits (sélectionné par défaut)."

msgid ""
"يعرض حالة التجربة الجافة والجرد والتطبيق والتراجع بشكل واضح للتجارب "
"المخبرية فقط."
msgstr ""
"Affiche clairement l'état du test à blanc, de l'inventaire, de "
"l'application et de l'annulation, pour les essais en laboratoire "
"uniquement."

msgid "يعرض محفظة الزبون وباقاته في واجهة عربية بسيطة بأربعة تبويبات."
msgstr ""
"Il affiche le portefeuille et les forfaits du client dans une interface "
"arabe simple à quatre onglets."

msgid "يعطّلها كلها دفعة واحدة."
msgstr "Les désactive toutes en une seule fois."

msgid "يعملان على آخر جلسة حددتها (إجراء فردي)."
msgstr "Ils agissent sur la dernière session sélectionnée (action individuelle)."

msgid ""
"يعيد البطاقة كغير مستخدمة ويمسح بداية الاستخدام والارتباط بالمستفيد، بدون"
" حذف سجل الجلسات."
msgstr ""
"Remet le coupon à l'état inutilisé et efface le début d'utilisation et le"
" lien avec le bénéficiaire, sans supprimer le journal des sessions."

msgid "يعيد حساب أرقام الحزم من البيانات الحالية."
msgstr "Recalcule les chiffres des forfaits à partir des données actuelles."

msgid "يعيد فحص البطاقة بأحدث البيانات."
msgstr "Revérifie le coupon avec les données les plus récentes."

msgid "يعيدك للوحة دون حفظ."
msgstr "Vous ramène au tableau de bord sans enregistrer."

msgid "يفتح"
msgstr "Ouvre"

msgid "يفتح جدول"
msgstr "Ouvre un tableau"

msgid "يفتح صفحة"
msgstr "Ouvre la page"

msgid "يفتح صفحة الحزمة بجدول بطاقاتها الكامل."
msgstr "Ouvre la page du lot avec son tableau complet de cartes."

msgid "يفتح صفحة منفصلة فيها جدول كل قوالبك وسجل التصدير الكامل."
msgstr ""
"Il ouvre une page distincte contenant un tableau de tous vos modèles et "
"le journal d'export complet."

msgid "يفتح صفوفها المجمّدة في نافذة."
msgstr "Ouvre ses lignes figées dans une fenêtre."

msgid "يفتح قائمة الكروت الملغاة."
msgstr "Ouvre la liste des coupons annulés."

msgid "يفتح قائمة الكروت مفلترة على المنتهية لتراجعها أو تؤرشفها."
msgstr ""
"Il ouvre la liste des coupons filtrée sur ceux expirés pour que vous "
"puissiez les vérifier ou les archiver."

msgid "يفتح نافذة"
msgstr "Ouvre une fenêtre"

msgid "يفتح نافذة الطباعة بنسخة نظيفة من الجدول."
msgstr "Ouvre la fenêtre d'impression avec une copie propre du tableau."

msgid "يفتح نافذة الطباعة مباشرة (الخطوة التالية)."
msgstr "Ouvre directement la fenêtre d'impression (l'étape suivante)."

msgid ""
"يفتح نافذة بمصغرات حقيقية لكل قوالبك — كل مصغرة هي بطاقة القالب الفعلية. "
"من نفس النافذة تقدر"
msgstr ""
"Ouvre une fenêtre avec de vraies vignettes pour tous vos modèles — chaque"
" vignette est la carte de modèle réelle. Depuis la même fenêtre, vous "
"pouvez"

msgid "يفتح نافذة تحدّد فيها"
msgstr "Ouvre une fenêtre où vous indiquez"

msgid "يفتح نافذة عائمة تكتب فيها"
msgstr "Ouvre une fenêtre flottante où vous saisissez"

msgid "يفتح نافذة عائمة — لكنها"
msgstr "Ouvre une fenêtre flottante — mais elle"

msgid ""
"يفتح نموذج تعديل إعدادات الحزمة (الأسعار، المدة، السلوك، قواعد السرعة) — "
"يؤثر على كروتها."
msgstr ""
"Ouvre le formulaire de modification des paramètres du forfait (prix, "
"durée, comportement, règles de vitesse) — affecte ses coupons."

msgid "يفتح نموذج تعديل المشترك مباشرة."
msgstr "Ouvre directement le formulaire de modification de l'abonné."

msgid "يفتحان ملف/تعديل"
msgstr "Ouvrent fichier/modifier"

msgid "يفتحه الزبون"
msgstr "Le client l'ouvre"

msgid "يفحص النظام اتصال الجهاز دوريًّا ويحدّث حالته في القائمة."
msgstr ""
"Le système vérifie périodiquement la connexion de l'équipement et met à "
"jour son statut dans la liste."

msgid "يفرغ /ip dns cache"
msgstr "Vide /ip dns cache"

msgid "يفعّل تطبيق حدود السرعة أدناه على المشترك."
msgstr "Active l'application des limites de vitesse ci-dessous à l'abonné."

msgid "يفعّل كل الراوترات المختارة دفعة واحدة."
msgstr "Active tous les routeurs sélectionnés en une seule fois."

msgid "يفعّل لوحة تحكم ذاتية للمشترك."
msgstr "Active un panneau de contrôle en libre-service pour l'abonné."

msgid ""
"يقرأ المحرك ملفات Excel / CSV / PDF ويستخرج أزواج اسم المستخدم وكلمة "
"المرور، ثم يضيفها إلى مخزون هذا العرض. الأسماء المكررة تُتخطى تلقائيًا. "
"الحد الأقصى 12MB و5000 بطاقة بالدفعة."
msgstr ""
"Le moteur lit les fichiers Excel / CSV / PDF et extrait les paires nom "
"d'utilisateur et mot de passe, puis les ajoute au stock de cette offre. "
"Les noms en double sont ignorés automatiquement. Le maximum est de 12 Mo "
"et 5000 coupons par lot."

msgid ""
"يقرأ المحرك ملفات Excel و CSV و PDF ويستخرج أزواج اسم المستخدم وكلمة "
"المرور، ثم يضيفها إلى مخزون هذا العرض. الأسماء المكررة تُتخطّى تلقائيًا. "
"الحدّ الأقصى"
msgstr ""
"Le moteur lit les fichiers Excel, CSV et PDF et extrait les paires nom "
"d'utilisateur et mot de passe, puis les ajoute au stock de cette offre. "
"Les noms en double sont ignorés automatiquement. Le maximum"

msgid "يقسم المبيعات: بنفسجي = مطبوعة، أخضر = إلكترونية."
msgstr "Répartit les ventes : violet = imprimées, vert = électroniques."

msgid "يقطع"
msgstr "Déconnecter"

msgid "يقطع اتصال الراوتر لدقيقة تقريبًا — لا تستخدمه وقت الذروة إلا لضرورة."
msgstr ""
"Il coupe la connexion du routeur pendant environ une minute — ne "
"l'utilisez aux heures de pointe qu'en cas de nécessité."

msgid "يقطع الاتصال عند انتهاء صلاحية العرض."
msgstr "Coupe la connexion à l'expiration de l'offre."

msgid "يقطع الاتصال لدقيقة"
msgstr "Coupe la connexion pendant une minute"

msgid "يقيّد الحساب على عنوان IP محدّد."
msgstr "Restreint le compte à une adresse IP spécifique."

msgid "يقيّد الحساب على عنوان MAC أول جهاز يدخل به."
msgstr ""
"Verrouille le compte sur l'adresse MAC du premier appareil qui se "
"connecte."

msgid "يقيّد دخول المشترك على منفذ معيّن في الراوتر."
msgstr "Restreint la connexion de l'abonné à un port spécifique du routeur."

msgid "يكتشف ويجهّز التنبيه"
msgstr "Détecte et prépare l'alerte"

msgid "يكسب:"
msgstr "Gagne :"

msgid "يكشفها (تنخفي تلقائيًا بعد 8 ثوانٍ وكل كشف يُسجَّل في سجل التدقيق)، وزر"
msgstr ""
"La révèle (elle se masque automatiquement après 8 secondes et chaque "
"révélation est enregistrée dans le journal d'audit), et un bouton"

msgid "يكمّل الصورة: حبّة خضراء برقم تعني أن المشترك"
msgstr "Complète le tableau : un point vert avec un chiffre signifie que l'abonné"

msgid "يلغي التحديد فيختفي الشريط."
msgstr "Annule la sélection, ce qui fait disparaître la barre."

msgid "يمسح البحث ويرجّع كل الصفوف فورًا."
msgstr "Efface la recherche et restaure instantanément toutes les lignes."

msgid "يمسح بيانات الاستخدام والجلسات عند التفعيل."
msgstr "Efface les données d'utilisation et de session lorsqu'il est activé."

msgid ""
"يمكن أن يبدأ الطلب من الريدياس، لكن لوحة التراخيص هي التي تحفظ النسخة "
"المشفرة النهائية وتزيد رقم الإصدار. لا يتم نقل بيانات كلمات المرور عبر "
"اتصال غير آمن في الإنتاج."
msgstr ""
"La demande peut commencer depuis RADIUS, mais c'est le panneau de "
"licences qui enregistre la copie chiffrée finale et incrémente le numéro "
"de version. Les données de mots de passe ne sont pas transmises via une "
"connexion non sécurisée en production."

msgid "يمكن إدخال نطاق بصيغة"
msgstr "Vous pouvez saisir une plage au format"

msgid "يمكن الاستعادة"
msgstr "Peut être restauré"

msgid "يمكن الرجوع من الوضع الهندسي عند الحاجة."
msgstr "Vous pouvez revenir du mode ingénierie en cas de besoin."

msgid "يمكنك أيضًا فتح هذه الغرفة من صفحة حزم البطاقات."
msgstr ""
"Vous pouvez aussi ouvrir cette salle depuis la page des forfaits de "
"coupons."

