msgstr "aucun mouvement d'argent, et le client reçoit une notification d'excuses."

#: app/templates/radius/docs_store_support.html:108
msgid "دعم المتجر ← طلبات الشحن"
msgstr "Support de la boutique ← Demandes de recharge"

#: app/templates/radius/docs_store_support.html:110
msgid "طلب شحن #142 — بانتظار المراجعة"
msgstr "Demande de recharge #142 — En attente d'examen"

#: app/templates/radius/docs_store_support.html:112
