msgid "يفتح نموذج تعديل المشترك مباشرة."
msgstr "Abone düzenleme formunu doğrudan açar."

msgid "يفتحان ملف/تعديل"
msgstr "Dosya/düzenle açar"

msgid "يفتحه الزبون"
msgstr "Müşteri onu açar"

msgid "يفحص النظام اتصال الجهاز دوريًّا ويحدّث حالته في القائمة."
msgstr ""
"Sistem, cihazın bağlantısını düzenli olarak kontrol eder ve durumunu "
"listede günceller."

msgid "يفرغ /ip dns cache"
msgstr "/ip dns cache'i temizler"

msgid "يفعّل تطبيق حدود السرعة أدناه على المشترك."
msgstr "Aşağıdaki hız sınırlarının aboneye uygulanmasını etkinleştirir."

msgid "يفعّل كل الراوترات المختارة دفعة واحدة."
msgstr "Seçili tüm yönlendiricileri tek seferde etkinleştirir."

msgid "يفعّل لوحة تحكم ذاتية للمشترك."
msgstr "Abone için self-servis kontrol panelini etkinleştirir."

msgid ""
"يقرأ المحرك ملفات Excel / CSV / PDF ويستخرج أزواج اسم المستخدم وكلمة "
"المرور، ثم يضيفها إلى مخزون هذا العرض. الأسماء المكررة تُتخطى تلقائيًا. "
"الحد الأقصى 12MB و5000 بطاقة بالدفعة."
msgstr ""
"Motor Excel / CSV / PDF dosyalarını okur ve kullanıcı adı ile parola "
"çiftlerini ayıklar, ardından bunları bu teklifin stoğuna ekler. Yinelenen"
" adlar otomatik olarak atlanır. Üst sınır parti başına 12MB ve 5000 "
"kupondur."

msgid ""
"يقرأ المحرك ملفات Excel و CSV و PDF ويستخرج أزواج اسم المستخدم وكلمة "
"المرور، ثم يضيفها إلى مخزون هذا العرض. الأسماء المكررة تُتخطّى تلقائيًا. "
"الحدّ الأقصى"
msgstr ""
"Motor Excel, CSV ve PDF dosyalarını okur ve kullanıcı adı ile parola "
"çiftlerini ayıklar, ardından bunları bu teklifin stoğuna ekler. Yinelenen"
" adlar otomatik olarak atlanır. Üst sınır"

msgid "يقسم المبيعات: بنفسجي = مطبوعة، أخضر = إلكترونية."
msgstr "Satışları ayırır: mor = basılı, yeşil = elektronik."

msgid "يقطع"
msgstr "Kes"

msgid "يقطع اتصال الراوتر لدقيقة تقريبًا — لا تستخدمه وقت الذروة إلا لضرورة."
msgstr ""
"Yönlendirici bağlantısını yaklaşık bir dakika keser — zorunlu olmadıkça "
"yoğun saatlerde kullanmayın."

msgid "يقطع الاتصال عند انتهاء صلاحية العرض."
msgstr "Teklifin süresi dolduğunda bağlantıyı keser."

msgid "يقطع الاتصال لدقيقة"
msgstr "Bağlantıyı bir dakika keser"

msgid "يقيّد الحساب على عنوان IP محدّد."
msgstr "Hesabı belirli bir IP adresiyle sınırlar."

msgid "يقيّد الحساب على عنوان MAC أول جهاز يدخل به."
msgstr "Hesabı, giriş yapan ilk cihazın MAC adresine kilitler."

msgid "يقيّد دخول المشترك على منفذ معيّن في الراوتر."
