msgid "يعيد حساب أرقام الحزم من البيانات الحالية."
msgstr "Paket sayılarını mevcut verilerden yeniden hesaplar."

msgid "يعيد فحص البطاقة بأحدث البيانات."
msgstr "Kuponu en güncel verilerle yeniden kontrol eder."

msgid "يعيدك للوحة دون حفظ."
msgstr "Kaydetmeden panoya döner."

msgid "يفتح"
msgstr "Açar"

msgid "يفتح جدول"
msgstr "Bir tablo açar"

msgid "يفتح صفحة"
msgstr "Sayfayı açar"

msgid "يفتح صفحة الحزمة بجدول بطاقاتها الكامل."
msgstr "Partinin sayfasını, kartlarının tam tablosuyla açar."

msgid "يفتح صفحة منفصلة فيها جدول كل قوالبك وسجل التصدير الكامل."
msgstr ""
"Tüm şablonlarınızın bir tablosunu ve tam dışa aktarma günlüğünü içeren "
"ayrı bir sayfa açar."

msgid "يفتح صفوفها المجمّدة في نافذة."
msgstr "Dondurulmuş satırlarını bir pencerede açar."

msgid "يفتح قائمة الكروت الملغاة."
msgstr "İptal edilen kuponların listesini açar."

msgid "يفتح قائمة الكروت مفلترة على المنتهية لتراجعها أو تؤرشفها."
msgstr ""
"Süresi dolanlara göre filtrelenmiş kupon listesini, gözden geçirmeniz "
"veya arşivlemeniz için açar."

msgid "يفتح نافذة"
msgstr "Bir pencere açar"

msgid "يفتح نافذة الطباعة بنسخة نظيفة من الجدول."
msgstr "Tablonun temiz bir kopyasıyla yazdırma penceresini açar."

msgid "يفتح نافذة الطباعة مباشرة (الخطوة التالية)."
msgstr "Yazdırma penceresini doğrudan açar (sonraki adım)."

msgid ""
"يفتح نافذة بمصغرات حقيقية لكل قوالبك — كل مصغرة هي بطاقة القالب الفعلية. "
"من نفس النافذة تقدر"
msgstr ""
"Tüm şablonlarınız için gerçek küçük resimler içeren bir pencere açar — "
"her küçük resim, gerçek şablon kartıdır. Aynı pencereden şunları "
"yapabilirsiniz"

msgid "يفتح نافذة تحدّد فيها"
msgstr "İçinde belirleyeceğiniz bir pencere açar"

msgid "يفتح نافذة عائمة تكتب فيها"
msgstr "İçine yazacağınız bir kayan pencere açar"

msgid "يفتح نافذة عائمة — لكنها"
msgstr "Kayan bir pencere açar — ancak"

msgid ""
"يفتح نموذج تعديل إعدادات الحزمة (الأسعار، المدة، السلوك، قواعد السرعة) — "
"يؤثر على كروتها."
msgstr ""
"Paket ayarlarını (fiyatlar, süre, davranış, hız kuralları) düzenleme "
