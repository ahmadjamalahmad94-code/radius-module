msgstr "Müşteriye gösterilen adres (zorunlu)."

#: app/templates/radius/docs_store_support.html:81
msgid "اسم صاحب الحساب ورقم الحساب"
msgstr "Hesap sahibinin adı ve hesap numarası"

#: app/templates/radius/docs_store_support.html:81
