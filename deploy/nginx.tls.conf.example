# HobeRadius — nginx HTTPS variant (TLS enabled)
#
# للتفعيل:
#   1. تأكّد من وجود شهادة Let's Encrypt على المضيف:
#        sudo bash deploy/deploy.sh tls <your-domain>
#   2. انسخ هذا الملف فوق nginx.conf الافتراضي:
#        sed "s|<DOMAIN>|radius.example.com|g" \
#            deploy/nginx.tls.conf.example > deploy/nginx.conf
#   3. أعد تشغيل nginx:
#        docker compose -f deploy/docker-compose.yml up -d --force-recreate nginx
#
# الـ placeholder <DOMAIN> لازم يُستبدَل قبل النشر — وإلا nginx لن يُحمّل
# الشهادة (هذا بالضبط ما حدث على VPS قبل هذا الـ commit).

# HTTP → HTTPS + ACME challenge
server {
    listen 80;
    server_name <DOMAIN>;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS
server {
    listen 443 ssl;
    http2 on;
    server_name <DOMAIN>;

    # ── Upstream re-resolve (fix3 integration, the client20 502 incident) ──
    # `proxy_pass` to a VARIABLE makes nginx resolve `hoberadius` through
    # Docker's embedded DNS (127.0.0.11) at request time, re-checking every
    # 10 s. A static `upstream { server hoberadius:8000; }` was resolved ONCE at
    # nginx start: recreating the hoberadius container gave it a new IP and
    # nginx kept proxying to the dead one (502) until nginx itself restarted.
    # It also means nginx starts even while hoberadius is still down.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    set $hr_app http://hoberadius:8000;

    ssl_certificate     /etc/letsencrypt/live/<DOMAIN>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<DOMAIN>/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;

    # security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    client_max_body_size 16M;
    gzip on;
    gzip_types text/css application/javascript application/json;
    gzip_min_length 1024;

    location /static/ {
        proxy_pass $hr_app;
        proxy_cache_valid 200 1h;
        expires 1h;
    }

    location = /admin/radius/_health {
        proxy_pass $hr_app;
        access_log off;
    }

    # ـ حماية المسارات الداخلية (انظر nginx.conf لتفاصيل السبب) ـ
    location ~ ^/api/v1/internal/ {
        return 404;
    }

    # معالج ترحيل بيانات العملاء — رفع تفريغ قاعدة كبير (حدّ جسم كبير + مهلة
    # أطول + بثّ). المسار العامّ يبقى عند الحدّ الافتراضيّ. يُفضَّل .gz.
    location /admin/radius/migrate/ {
        client_max_body_size 1024m;
        proxy_request_buffering off;
        proxy_pass $hr_app;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout  600s;
        proxy_send_timeout  600s;
    }

    # ── /api/ with load shedding (zones + sizing: nginx-main.conf) ──
    # Same proxying as `location /`; over the limits nginx answers a JSON 503
    # instead of letting gunicorn drown. (The app's own 503s pass through
    # untouched: proxy_intercept_errors is off.)
    location /api/ {
        limit_req  zone=hr_api_rate burst=400 nodelay;
        limit_conn hr_api_conn_ip 256;
        limit_conn hr_api_conn_all 512;
        error_page 503 = @hr_api_overloaded;
        proxy_pass $hr_app;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout  60s;
        proxy_send_timeout  60s;
    }

    location @hr_api_overloaded {
        default_type application/json;
        add_header Retry-After 2 always;
        return 503 '{"ok":false,"error":{"code":"server_busy","message":"الخادم مشغول الآن — أعد المحاولة بعد لحظات.","details":{}}}';
    }

    location / {
        proxy_pass $hr_app;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout  60s;
        proxy_send_timeout  60s;
    }
}
