[Unit]
Description=HobeRadius — watch wg0.conf + peers.d for changes

[Path]
# Fires when:
#   a) root edits the main wg0.conf (rare)
#   b) the HobeRadius container creates / modifies / deletes a file
#      under /etc/hoberadius/wg-peers.d/  (the regular case)
PathChanged=/etc/wireguard/wg0.conf
PathChanged=/etc/hoberadius/wg-peers.d
Unit=wg-reload.service

[Install]
WantedBy=multi-user.target
