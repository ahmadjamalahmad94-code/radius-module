[Unit]
Description=HobeRadius — watch peers.d for peer changes

[Path]
# Fires when the HobeRadius container creates / modifies / deletes
# a file under /etc/hoberadius/wg-peers.d/. We deliberately do NOT
# watch /etc/wireguard/wg0.conf — that file holds the server's
# [Interface] block (private key + address + listen port). A
# reload triggered by editing it would feed wg syncconf an empty
# peer set (the file has no [Peer] blocks) and remove every peer.
# If root edits wg0.conf, the right reload is `systemctl restart
# wg-quick@wg0` — not this path-unit.
PathChanged=/etc/hoberadius/wg-peers.d
Unit=wg-reload.service

[Install]
WantedBy=multi-user.target
