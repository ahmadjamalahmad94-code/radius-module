policy filter_username {
    if (&User-Name) {
        if (&User-Name =~ /\\s/) {
            update request {
                &Module-Failure-Message += 'Rejected: Username contains whitespace'
            }
            reject
        }
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# normalize_username — يشذّب المسافات من طرفَي User-Name (بدل رفضها).
# السبب: أجهزة/بطاقات تُلحق مسافةً بآخر الكود (مثال البطاقة 677479934120 على
# gr3)، فتُخزَّن جلسات radacct باسمٍ فيه مسافة يختلف عن جدول المشتركين النظيف
# → عدّ أجهزة خاطئ («فُتحت على جهازين بنفس الوقت») + احتمال تجاوز shared-users=1
# على المايكروتيك (اسمان مختلفان = مستخدمان مختلفان). rest/Flask يشذّب أصلًا
# (radpostauth نظيف)، لكن accounting sql يكتب الاسم الخام — هنا التوحيد.
# يُستدعى في authorize (قبل rest/sql) و preacct (قبل accounting sql).
# ملاحظة: منتهي بـ noop في فرع else كي يُرجع rcode سليمًا دائمًا.
# ─────────────────────────────────────────────────────────────────────────────
normalize_username {
    if (&User-Name =~ /^[[:space:]]*(.*[^[:space:]])[[:space:]]*$/) {
        update request {
            &User-Name := "%{1}"
        }
    }
    else {
        noop
    }
}
