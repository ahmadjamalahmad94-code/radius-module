# ─────────────────────────────────────────────────────────────────────────────
# rest — يستدعي HobeRadius /api/v1/internal/auth ليقرّر Accept/Reject
# ـ هذا هو الـ "policy engine" الفعلي: كل القرارات تذهب لـ Python.
# FreeRADIUS هنا = RADIUS protocol terminator فقط.
# ─────────────────────────────────────────────────────────────────────────────
rest {
    tls {
    }

    connect_uri = "http://hoberadius:8000"
    connect_timeout = 4.0

    # ─ HTTP headers (X-Internal-Secret) ─
    # تنبيه: المعامل `header = ...` هنا غير موجود في rlm_rest section parser
    # على FreeRADIUS 3.2.x ـ كان يُتجاهَل بصمت ولذلك الطلبات كانت تصل لـ Flask
    # بدون X-Internal-Secret فيردّ 401. الحقن يتمّ الآن في sites-enabled/default
    # عبر `update request { REST-HTTP-Header := "X-Internal-Secret: ..." }`
    # قبل كل استدعاء `rest`. لا تُضِف header = هنا.
    authorize {
        uri      = "${..connect_uri}/api/v1/internal/auth"
        method   = "post"
        body     = "json"
        # ـ نُمرّر CHAP-Password + CHAP-Challenge أيضًا لأن MikroTik hotspot
        # يستخدم HTTP-CHAP افتراضيًا، فـ %{User-Password} يكون فارغًا.
        # سياسة التحقّق (PAP vs CHAP) تُنفَّذ داخل /api/v1/internal/auth.
        data     = '{ \
            "User-Name": "%{User-Name}", \
            "User-Password": "%{User-Password}", \
            "CHAP-Password": "%{CHAP-Password}", \
            "CHAP-Challenge": "%{CHAP-Challenge}", \
            "Calling-Station-Id": "%{Calling-Station-Id}", \
            "Called-Station-Id": "%{Called-Station-Id}", \
            "NAS-IP-Address": "%{NAS-IP-Address}", \
            "NAS-Port-Type": "%{NAS-Port-Type}", \
            "Framed-IP-Address": "%{Framed-IP-Address}" \
        }'
        tls = ${..tls}
    }

    # ـ نُعطل authenticate (نتركها لـ FreeRADIUS) ـ
    authenticate {}

    # ـ post-auth webhook: Flask يكتب radpostauth داخليًا + يُرسل أحداث ـ
    # ـ لاحظ: لا نستدعي sql في post-auth (انظر sites-enabled/default) ـ
    # ـ X-Internal-Secret يُحقَن في sites-enabled/default (انظر التعليق أعلاه) ـ
    post-auth {
        uri      = "${..connect_uri}/api/v1/internal/postauth"
        method   = "post"
        body     = "json"
        data     = '{ \
            "User-Name": "%{User-Name}", \
            "reply_code": "%{reply:Packet-Type}", \
            "NAS-IP-Address": "%{NAS-IP-Address}" \
        }'
        tls = ${..tls}
    }

    # ─ lazy pool: نتجنّب فتح أي connection عند startup ─
    # السبب: DNS lookup لـ "hoberadius:8000" قد يفشل أثناء instantiation لو
    # كان hoberadius container لم يصل بعدُ لحالة جاهزة (race مع docker DNS،
    # خصوصًا لو hoberadius نفسه يدور في restart-loop). start=0 + min=0
    # يجعل الـ pool يفتح connections عند أوّل طلب فعلي، لا أثناء الإقلاع.
    # freeradius يبقى Ready to process requests حتى لو كان hoberadius
    # مؤقّتًا غير قابل للوصول (طلب RADIUS سيُرجِع reject في تلك الحالة).
    pool {
        start          = 0
        min            = 0
        max            = 32
        spare          = 8
        uses           = 0
        retry_delay    = 5
        lifetime       = 0
        idle_timeout   = 60
    }
}
