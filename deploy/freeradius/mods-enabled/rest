# ─────────────────────────────────────────────────────────────────────────────
# rest — يستدعي HobeRadius /api/v1/internal/auth ليقرّر Accept/Reject
# ـ هذا هو الـ "policy engine" الفعلي: كل القرارات تذهب لـ Python.
# FreeRADIUS هنا = RADIUS protocol terminator فقط.
# ─────────────────────────────────────────────────────────────────────────────
rest {
    tls {
    }

    # Was: http://hoberadius:8000 (docker DNS via the hrnet bridge).
    # Now: http://127.0.0.1:8000 because freeradius runs with
    # network_mode: host (postmortem #19) and can no longer resolve
    # the docker service name. The hoberadius service exposes
    # 8000 on the host's loopback via `127.0.0.1:8000:8000`, so
    # this works without exposing 8000 to the public internet.
    #
    # Stress L01 (2026-09-28): now :8001 — the DEDICATED RADIUS auth gunicorn
    # instance (deploy/entrypoint.sh, role "auth"), no longer the panel's
    # :8000. Logins and the admin panel each get their own threads, so neither
    # can freeze the other (L01 B7: 25–35 s app-wide freezes).
    connect_uri = "http://127.0.0.1:8001"
    # Loopback connect is sub-millisecond; 2 s only covers a restarting app.
    connect_timeout = 2.0

    # ─ ملاحظة عن X-Internal-Secret ─
    # rlm_rest في FreeRADIUS 3.2.x لا يدعم إضافة custom HTTP headers
    #   - المعامل `header = ...` هنا غير معروف لـ section parser → يُتجاهَل بصمت.
    #   - الـ attribute `REST-HTTP-Header` ميزة FR 4.x، غير موجودة في 3.2.5.
    # الحلّ المعتمد: نمرّر السرّ داخل JSON body كحقل _internal_secret،
    # و Flask يقبل من الـ header أو من الـ body. الـ placeholder
    # __HR_INTERNAL_SECRET__ يُستبدَل في entrypoint.sh بقيمة
    # HOBERADIUS_INTERNAL_SECRET من env.
    authorize {
        uri      = "${..connect_uri}/api/v1/internal/auth"
        method   = "post"
        body     = "json"
        # ـ نُمرّر CHAP-Password + CHAP-Challenge أيضًا لأن MikroTik hotspot
        # يستخدم HTTP-CHAP افتراضيًا، فـ %{User-Password} يكون فارغًا.
        # سياسة التحقّق (PAP vs CHAP) تُنفَّذ داخل /api/v1/internal/auth.
        data     = '{ \
            "_internal_secret": "__HR_INTERNAL_SECRET__", \
            "User-Name": "%{User-Name}", \
            "User-Password": "%{User-Password}", \
            "CHAP-Password": "%{CHAP-Password}", \
            "CHAP-Challenge": "%{CHAP-Challenge}", \
            "Calling-Station-Id": "%{Calling-Station-Id}", \
            "Called-Station-Id": "%{Called-Station-Id}", \
            "NAS-IP-Address": "%{NAS-IP-Address}", \
            "NAS-Port-Type": "%{NAS-Port-Type}", \
            "Framed-IP-Address": "%{Framed-IP-Address}" \
        }'
        tls = ${..tls}
        # Whole-request timeout. The engine answers in a few ms; anything
        # slower is a stalled backend — fail fast (sites-enabled/default then
        # stays SILENT so the NAS retransmits, instead of rejecting a valid
        # password) and free the FreeRADIUS thread.
        timeout = 3.0
    }

    # ـ نُعطل authenticate (نتركها لـ FreeRADIUS) ـ
    authenticate {}

    # ـ post-auth webhook: Flask يكتب radpostauth داخليًا + يُرسل أحداث ـ
    # ـ لاحظ: لا نستدعي sql في post-auth (انظر sites-enabled/default) ـ
    post-auth {
        uri      = "${..connect_uri}/api/v1/internal/postauth"
        method   = "post"
        body     = "json"
        data     = '{ \
            "_internal_secret": "__HR_INTERNAL_SECRET__", \
            "User-Name": "%{User-Name}", \
            "reply_code": "%{reply:Packet-Type}", \
            "NAS-IP-Address": "%{NAS-IP-Address}" \
        }'
        tls = ${..tls}
        timeout = 3.0
    }

    # ─ lazy pool: نتجنّب فتح أي connection عند startup ─
    # السبب: TCP connect إلى "127.0.0.1:8000" قد يفشل أثناء instantiation
    # لو كان hoberadius container لم يصل بعدُ لحالة جاهزة (race ضد
    # supervisor start order، خصوصًا لو hoberadius يدور في restart-loop).
    # start=0 + min=0 يجعل الـ pool يفتح connections عند أوّل طلب فعلي،
    # لا أثناء الإقلاع. freeradius يبقى Ready to process requests حتى لو
    # كان hoberadius مؤقّتًا غير قابل للوصول (طلب RADIUS سيُرجِع reject في
    # تلك الحالة).
    #
    # (Since stress L01 an unreachable app gives NO response — not a reject —
    # so the NAS retransmits; see the `rest { fail = 1 }` block in
    # sites-enabled/default.)
    #
    # Pool sizing (stress L01):
    #   max = 32 = thread pool max_servers (radiusd.conf): one connection per
    #         FreeRADIUS thread, never more (the auth gunicorn has 2x16 threads).
    #   spare = 4: a few warm connections for a burst without parking many idle
    #         sockets on the app.
    #   idle_timeout = 30 s - MUST stay BELOW the auth gunicorn keep-alive
    #         (75 s, deploy/gunicorn.conf.py) so FreeRADIUS always closes an idle
    #         connection first. It was 60 s against gunicorn's 5 s, so FreeRADIUS
    #         reused sockets the app had closed ("Server returned no data").
    #   retry_delay = 1: after a failed connect (app restarting) retry within
    #         a second, not five.
    pool {
        start          = 0
        min            = 0
        max            = 32
        spare          = 4
        uses           = 0
        retry_delay    = 1
        lifetime       = 0
        idle_timeout   = 30
    }
}
