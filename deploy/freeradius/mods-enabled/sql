# ─────────────────────────────────────────────────────────────────────────────
# sql — backend SQLite يقرأ/يكتب نفس DB الـ HobeRadius.
# الاستخدام الوحيد المعتمد حاليًا:
#  - accounting: كتابة radacct (sessions reporting). معزول عن auth.
#
# ـ لا نستخدمه في authorize/authenticate (rest يقرّر) ـ
# ـ لا نستخدمه في post-auth (Flask يكتب radpostauth داخليًا) ـ
#
# سبب الفصل: rlm_sql_sqlite قد يفشل (Hit reconnection limit، locked DB) عند
# تزامن كتابة Flask + FreeRADIUS على نفس SQLite. لو كان sql في post-auth،
# فشله يحوّل Access-Accept إلى Reject. الفصل يحافظ على auth حتى لو SQL تعطّل.
# ─────────────────────────────────────────────────────────────────────────────
sql {
    dialect  = "sqlite"
    driver   = "rlm_sql_sqlite"

    sqlite {
        # نفس الـ SQLite الذي يستخدمه HobeRadius. الـ filename يطابق
        # HOBERADIUS_DB_PATH من .env (افتراضي hoberadius.db).
        # ـ compose يربط ../instance:/data ـ
        filename    = "/data/hoberadius.db"
        busy_timeout = 30000
        bootstrap   = ""    # لا نُنشئ schema — HobeRadius migrations تتولّى
    }

    # ـ schema FreeRADIUS قياسي (موجود في 010_freeradius_schema.sql) ـ
    acct_table1     = "radacct"
    acct_table2     = "radacct"
    postauth_table  = "radpostauth"
    authcheck_table = "radcheck"
    authreply_table = "radreply"
    groupcheck_table = "radgroupcheck"
    groupreply_table = "radgroupreply"
    usergroup_table = "radusergroup"
    read_groups     = yes
    read_profiles   = yes
    delete_stale_sessions = yes

    # ─ clients من جدول nas — معطّل مؤقتًا ─
    # السبب: migration 010_freeradius_schema.sql لم يُطبَّق على هذه الـ DB
    # فجدول `nas` غير موجود. إن أبقينا read_clients = yes فإنّ الـ sql
    # module يفشل instantiation و freeradius لا يقلع.
    #
    # الحلّ المؤقّت: الاعتماد على clients.conf الثابت (يحوي localhost +
    # docker network، وتضاف أجهزة MikroTik يدويًا إلى الـ file حتى يكتمل
    # الـ NAS DB sync layer).
    #
    # للتفعيل لاحقًا بعد تطبيق migration 010 + nas_devices→nas sync:
    #   client_table    = "nas"
    #   read_clients    = yes
    #   client_query    = "SELECT nasname, shortname, type, secret FROM nas"
    read_clients    = no

    # ـ lazy pool: لا تفتح أي connection عند startup ـ
    # نفس النمط المُستخدم في mods-enabled/rest. لو SQLite غير متاح وقت
    # الإقلاع، FreeRADIUS يبقى Ready ولا يفشل instantiation. أوّل acct
    # request هو الذي يفتح أول connection.
    pool {
        start          = 0
        min            = 0
        max            = 8
        spare          = 2
        uses           = 0
        retry_delay    = 5
        lifetime       = 0
        idle_timeout   = 60
    }

    group_attribute = "${.:instance}-SQL-Group"

    # ─────────────────────────────────────────────────────────────────────
    # accounting queries — هيكل nested قياسي لـ FR 3.x rlm_sql.
    #
    # السبب: rlm_sql في FR 3.2.x لا يقرأ accounting_start_query /
    # accounting_update_query / accounting_stop_query كـ top-level keys
    # في sql{}؛ هذه أسماء لا توجد في module_config parser فيُتجاهَلها
    # بصمت. الهيكل المعتمد هو:
    #     accounting {
    #         reference = "%{tolower:type.%{Acct-Status-Type}.query}"
    #         type { start { query = ... } interim-update { ... } stop { ... } }
    #     }
    # كل packet يدخل accounting{} في sites-enabled/default يُحلّ الـ
    # reference إلى المسار المناسب (مثلاً Acct-Status-Type=Start →
    # type.start.query) ويُنفّذ.
    #
    # WHERE keying:
    #   نستخدم (acctsessionid, nasipaddress, acctstoptime IS NULL) بدل
    #   acctuniqueid لأن rlm_acct_unique غير مُحمَّل في هذا image (الـ
    #   .so ليس مشحوناً)، فـ %{Acct-Unique-Session-Id} يُحلّ فارغًا.
    #   الـ tuple أعلاه فريد لكل جلسة حيّة (RFC 2866 §5.5).
    # ─────────────────────────────────────────────────────────────────────
    accounting {
        reference = "%{tolower:type.%{Acct-Status-Type}.query}"

        type {
            accounting-on {
                query = "\
                    UPDATE ${....acct_table1} SET \
                        acctstoptime = datetime('now'), \
                        acctterminatecause = 'NAS-Reboot' \
                    WHERE nasipaddress = '%{NAS-IP-Address}' \
                      AND acctstoptime IS NULL"
            }

            accounting-off {
                query = "\
                    UPDATE ${....acct_table1} SET \
                        acctstoptime = datetime('now'), \
                        acctterminatecause = 'NAS-Reboot' \
                    WHERE nasipaddress = '%{NAS-IP-Address}' \
                      AND acctstoptime IS NULL"
            }

            start {
                # R7 — قيم xlat الصحيحة:
                #   - %{User-Name} بدل %{SQL-User-Name}: الأخير لا يُحدَّد إلا
                #     عندما يكون rlm_sql في authorize/post-auth context،
                #     فيُحلّ فارغًا في accounting → username=''.
                #   - acctuniqueid يُبنى يدويًا (NAS-IP + Session-Id + User)
                #     لأن rlm_acct_unique غير محمَّل (الـ .so غير مشحون في
                #     image 3.2.5)، فـ %{Acct-Unique-Session-Id} فارغ.
                #     الـ tuple يضمن تفرّد عبر NAS devices وusers.
                query = "\
                    INSERT INTO ${....acct_table1} \
                        (tenant_id, acctsessionid, acctuniqueid, username, realm, \
                         nasipaddress, nasportid, nasporttype, acctstarttime, \
                         acctauthentic, connectinfo_start, calledstationid, callingstationid, \
                         servicetype, framedprotocol, framedipaddress, framedipv6address, \
                         framedipv6prefix, framedinterfaceid, delegatedipv6prefix) \
                    VALUES \
                        (1, '%{Acct-Session-Id}', \
                         '%{NAS-IP-Address}-%{Acct-Session-Id}-%{User-Name}', \
                         '%{User-Name}', '%{Realm}', \
                         '%{NAS-IP-Address}', '%{NAS-Port}', '%{NAS-Port-Type}', \
                         datetime('now'), \
                         '%{Acct-Authentic}', '%{Connect-Info}', \
                         '%{Called-Station-Id}', '%{Calling-Station-Id}', \
                         '%{Service-Type}', '%{Framed-Protocol}', \
                         '%{Framed-IP-Address}', '%{Framed-IPv6-Address}', \
                         '%{Framed-IPv6-Prefix}', '%{Framed-Interface-Id}', \
                         '%{Delegated-IPv6-Prefix}')"
            }

            interim-update {
                query = "\
                    UPDATE ${....acct_table1} SET \
                        acctupdatetime  = datetime('now'), \
                        acctinterval    = '%{Acct-Interim-Interval}', \
                        acctsessiontime = '%{Acct-Session-Time}', \
                        acctinputoctets = '%{Acct-Input-Octets}', \
                        acctoutputoctets= '%{Acct-Output-Octets}', \
                        framedipaddress = '%{Framed-IP-Address}' \
                    WHERE acctsessionid = '%{Acct-Session-Id}' \
                      AND nasipaddress  = '%{NAS-IP-Address}' \
                      AND acctstoptime IS NULL"
            }

            stop {
                query = "\
                    UPDATE ${....acct_table1} SET \
                        acctstoptime       = datetime('now'), \
                        acctsessiontime    = '%{Acct-Session-Time}', \
                        acctinputoctets    = '%{Acct-Input-Octets}', \
                        acctoutputoctets   = '%{Acct-Output-Octets}', \
                        acctterminatecause = '%{Acct-Terminate-Cause}', \
                        connectinfo_stop   = '%{Connect-Info}' \
                    WHERE acctsessionid = '%{Acct-Session-Id}' \
                      AND nasipaddress  = '%{NAS-IP-Address}' \
                      AND acctstoptime IS NULL"
            }
        }
    }

    # ـ post-auth query محفوظة لو احتجناها مستقبلاً — حاليًا الـ
    # sites-enabled/default لا يستدعي sql في post-auth (Flask يكتب
    # radpostauth داخليًا عبر policy_engine._log_attempt).
    post-auth {
        query = "\
            INSERT INTO radpostauth \
                (tenant_id, username, pass, reply, authdate, class, nas) \
            VALUES \
                (1, '%{User-Name}', '%{User-Password}', '%{reply:Packet-Type}', \
                 datetime('now'), '', '%{NAS-IP-Address}')"
    }
}
