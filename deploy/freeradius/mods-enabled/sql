# ─────────────────────────────────────────────────────────────────────────────
# sql — backend SQLite يقرأ/يكتب نفس DB الـ HobeRadius.
# الاستخدام الوحيد المعتمد حاليًا:
#  - accounting: كتابة radacct (sessions reporting). معزول عن auth.
#
# ـ لا نستخدمه في authorize/authenticate (rest يقرّر) ـ
# ـ لا نستخدمه في post-auth (Flask يكتب radpostauth داخليًا) ـ
#
# سبب الفصل: rlm_sql_sqlite قد يفشل (Hit reconnection limit، locked DB) عند
# تزامن كتابة Flask + FreeRADIUS على نفس SQLite. لو كان sql في post-auth،
# فشله يحوّل Access-Accept إلى Reject. الفصل يحافظ على auth حتى لو SQL تعطّل.
# ─────────────────────────────────────────────────────────────────────────────
sql {
    dialect  = "sqlite"
    driver   = "rlm_sql_sqlite"

    sqlite {
        # نفس الـ SQLite الذي يستخدمه HobeRadius. الـ filename يطابق
        # HOBERADIUS_DB_PATH من .env (افتراضي hoberadius.db).
        # ـ compose يربط ../instance:/data ـ
        filename    = "/data/hoberadius.db"
        busy_timeout = 30000
        bootstrap   = ""    # لا نُنشئ schema — HobeRadius migrations تتولّى
    }

    # ـ schema FreeRADIUS قياسي (موجود في 010_freeradius_schema.sql) ـ
    acct_table1     = "radacct"
    acct_table2     = "radacct"
    postauth_table  = "radpostauth"
    authcheck_table = "radcheck"
    authreply_table = "radreply"
    groupcheck_table = "radgroupcheck"
    groupreply_table = "radgroupreply"
    usergroup_table = "radusergroup"
    # ـ read_groups/read_profiles = no ـ
    # المسار الوحيد الذي يستدعي sql في authorize هو نفق الإدارة rtr-* (انظر
    # sites-enabled/default). تلك الحسابات لا تستخدم مجموعات/بروفايلات — فقط
    # radcheck (Cleartext/NT-Password) + radreply (Framed-IP). تركهما `yes` بلا
    # group_membership_query يطبع تحذير "read_groups = yes, but no
    # group_membership_query" في كل طلب. نُطفئهما لمسار rtr- النظيف.
    read_groups     = no
    read_profiles   = no
    delete_stale_sessions = yes

    # ─ sql_user_name — اسم المستخدم الذي تُبنى عليه authorize_check_query ─
    # حاسم لمسار نفق الإدارة rtr-*: الـauthorize في sites-enabled/default يستدعي
    # هذا الـsql module ليحمّل radcheck عبر `%{SQL-User-Name}`. قيمة
    # `%{SQL-User-Name}` تأتي من sql_user_name. لو تُرك غير مضبوط يردّ rlm_sql
    # إلى السلسلة الفارغة "" فيُحلّ `%{SQL-User-Name}` فارغًا، فيرفض rlm_sql
    # الاستعلام (zero-length username) ويُعيد notfound **بلا أي EXPAND/Executing
    # query** — وهو بالضبط ما رأيناه في freeradius -X لـrtr-ccr5.
    #
    # القيمة القياسية (نفس ما تشحنه mods-available/sql الرسميّة): استخدم
    # Stripped-User-Name إن وُجد، وإلّا ارتدّ إلى User-Name الكامل. لا realm في
    # نفق الإدارة فـStripped-User-Name فارغ، فالارتداد يُعطي User-Name = الاسم
    # الحرفيّ `rtr-<name>` — فيُستعلَم radcheck به دائمًا.
    sql_user_name = "%{%{Stripped-User-Name}:-%{User-Name}}"

    # ─ authorize check/reply queries — تحميل radcheck/radreply (مسار rtr-*) ─
    # بدونهما يطبع rlm_sql «No authorization checks configured, returning noop»
    # فلا يُحمّل Cleartext-Password/NT-Password من radcheck أبدًا → mschap noop →
    # Auth-Type:=PAP → «No password configured» → Access-Reject. ضبط
    # authcheck_table/authreply_table وحده لا يكفي: FR 3.2.x لا يشتقّ الاستعلام
    # تلقائيًّا ما لم تُضمَّن stock queries.conf (نحن لا نُضمّنها — وحدة مكتفية
    # ذاتيًّا). هذه الاستعلامات هي صيغة sqlite القياسيّة من mods-config/sql/main/
    # sqlite/queries.conf، تُحلّ ${authcheck_table}=radcheck و
    # ${authreply_table}=radreply و%{SQL-User-Name}=rtr-<name>.
    authorize_check_query = "SELECT id, username, attribute, value, op FROM ${authcheck_table} WHERE username = '%{SQL-User-Name}' ORDER BY id"
    authorize_reply_query = "SELECT id, username, attribute, value, op FROM ${authreply_table} WHERE username = '%{SQL-User-Name}' ORDER BY id"

    # ـ read_groups/read_profiles = no (أعلاه) فاستعلامات المجموعات غير مطلوبة ـ
    # مسار rtr-* لا يستخدم radgroupcheck/radgroupreply/radusergroup. نتركها غير
    # معرّفة عمدًا — rlm_sql لا يطلبها ما دام read_groups=no.

    # ─ clients من جدول nas — مُفعَّل (Phase M4) ─
    # migration 010_freeradius_schema.sql مطبَّق ويُنشئ جدول `nas`.
    # الـ M4 wizard sync يكتب صفًا في `nas` لكل راوتر تُنشئه
    # (راجع mt_setup.py).
    #
    # ملاحظة على الـ query: FR 3.2.x يتوقع **9 حقول بالضبط**:
    #   id, nasname, shortname, type, secret, server, community,
    #   description, require_message_authenticator.
    # تقديم عدد أقل يطبع
    #   "SELECT returned too few fields. Please do not edit client_query"
    # ويُهمَل الـ client كلياً. عمودنا اسمه `require_ma` فنُسمّيه
    # عبر AS لتطابق ما يتوقعه FR.
    client_table    = "nas"
    read_clients    = yes
    client_query    = "SELECT id, nasname, shortname, type, secret, server, community, description, require_ma AS require_message_authenticator FROM nas"

    # ـ lazy pool: لا تفتح أي connection عند startup ـ
    # نفس النمط المُستخدم في mods-enabled/rest. لو SQLite غير متاح وقت
    # الإقلاع، FreeRADIUS يبقى Ready ولا يفشل instantiation. أوّل acct
    # request هو الذي يفتح أول connection.
    pool {
        start          = 0
        min            = 0
        max            = 8
        spare          = 2
        uses           = 0
        retry_delay    = 5
        lifetime       = 0
        idle_timeout   = 60
    }

    group_attribute = "${.:instance}-SQL-Group"

    # ─────────────────────────────────────────────────────────────────────
    # accounting queries — هيكل nested قياسي لـ FR 3.x rlm_sql.
    #
    # السبب: rlm_sql في FR 3.2.x لا يقرأ accounting_start_query /
    # accounting_update_query / accounting_stop_query كـ top-level keys
    # في sql{}؛ هذه أسماء لا توجد في module_config parser فيُتجاهَلها
    # بصمت. الهيكل المعتمد هو:
    #     accounting {
    #         reference = "%{tolower:type.%{Acct-Status-Type}.query}"
    #         type { start { query = ... } interim-update { ... } stop { ... } }
    #     }
    # كل packet يدخل accounting{} في sites-enabled/default يُحلّ الـ
    # reference إلى المسار المناسب (مثلاً Acct-Status-Type=Start →
    # type.start.query) ويُنفّذ.
    #
    # WHERE keying:
    #   نستخدم (acctsessionid, nasipaddress, acctstoptime IS NULL) بدل
    #   acctuniqueid لأن rlm_acct_unique غير مُحمَّل في هذا image (الـ
    #   .so ليس مشحوناً)، فـ %{Acct-Unique-Session-Id} يُحلّ فارغًا.
    #   الـ tuple أعلاه فريد لكل جلسة حيّة (RFC 2866 §5.5).
    # ─────────────────────────────────────────────────────────────────────
    accounting {
        reference = "%{tolower:type.%{Acct-Status-Type}.query}"

        type {
            accounting-on {
                # R10.6: نُغلق فقط الـ rows التي كُتبت بنفس Packet-Src-IP
                # (للاتساق مع start/interim/stop).
                query = "\
                    UPDATE ${....acct_table1} SET \
                        acctstoptime = datetime('now'), \
                        acctterminatecause = 'NAS-Reboot' \
                    WHERE nasipaddress = '%{Packet-Src-IP-Address}' \
                      AND acctstoptime IS NULL"
            }

            accounting-off {
                query = "\
                    UPDATE ${....acct_table1} SET \
                        acctstoptime = datetime('now'), \
                        acctterminatecause = 'NAS-Reboot' \
                    WHERE nasipaddress = '%{Packet-Src-IP-Address}' \
                      AND acctstoptime IS NULL"
            }

            start {
                # R7 — قيم xlat الصحيحة:
                #   - %{User-Name} بدل %{SQL-User-Name}: الأخير لا يُحدَّد إلا
                #     عندما يكون rlm_sql في authorize/post-auth context،
                #     فيُحلّ فارغًا في accounting → username=''.
                #   - acctuniqueid يُبنى يدويًا (Packet-Src-IP + Session-Id +
                #     User) لأن rlm_acct_unique غير محمَّل في image 3.2.5.
                #
                # R10.6 — `nasipaddress` يُخزَّن بـ %{Packet-Src-IP-Address}
                # (الـ IP الذي وصل منه الـ UDP packet فعلاً، بعد NAT الـ ISP)
                # بدل %{NAS-IP-Address} (الذي يكتبه MikroTik داخل الـ packet
                # وغالبًا يكون private LAN IP غير قابل للوصول من VPS).
                # الـ change يجعل radacct.nasipaddress يطابق ما نراه نحن
                # من السلك، فـ find_nas_for_session في radius_coa يجد الـ
                # nas_devices entry الصحيح، و CoA + Disconnect تذهبان لـ
                # IP فعلاً قابل للوصول. لاحظي: لا أثر على الـ Auth ولا
                # على الـ accounting itself — فقط على الـ "العنوان"
                # المخزَّن في radacct.
                #
                # MT69 — 🔴 عطبٌ إنتاجيّ: كان الاشتقاق من جدول `nas` وحده،
                # وهو **فارغ** منذ صار تسجيل الراوترات بملفّات
                # clients-wizard لا بصفوف SQL (`upsert_nas_client` بلا
                # مستدعٍ). فكان COALESCE يسقط دائمًا على 1 ⇒ **كل محاسبة
                # عملاء الاستضافة تهبط في جهة المزوّد**: الشبكة لا ترى
                # جلساتها ولا استهلاكها ولا تُنفَّذ كوتاها، والمزوّد يرى
                # بيانات الجميع مختلطة. المصدر الموثوق الآن `nas_devices`
                # (جدول اللوحة: tenant_id + address)، ويبقى `nas` ارتدادًا
                # للتثبيتات الأحاديّة القديمة، ثمّ 1.
                # (الأصل) MT1 — multi-tenant: tenant_id يُشتقّ من جدول nas (نفس
                # الجدول الذي طابق FreeRADIUS به هذا الـ client أصلًا عبر
                # read_clients) حسب Packet-Src-IP-Address. الارتداد لـ 1
                # يحفظ سلوك التثبيت أحادي الجهة (صفوف nas القديمة كلها
                # tenant 1) — التفرقة بين الجهات مضمونة بقيد فريد على
                # العنوان عبر الجهات (migration 162).
                query = "\
                    INSERT INTO ${....acct_table1} \
                        (tenant_id, acctsessionid, acctuniqueid, username, realm, \
                         nasipaddress, nasportid, nasporttype, acctstarttime, \
                         acctauthentic, connectinfo_start, calledstationid, callingstationid, \
                         servicetype, framedprotocol, framedipaddress, framedipv6address, \
                         framedipv6prefix, framedinterfaceid, delegatedipv6prefix) \
                    VALUES \
                        (COALESCE((SELECT tenant_id FROM nas_devices \
                                   WHERE address = '%{Packet-Src-IP-Address}' \
                                     AND enabled = 1 AND deleted_at IS NULL \
                                   ORDER BY id LIMIT 1), \
                                  (SELECT tenant_id FROM nas \
                                   WHERE nasname = '%{Packet-Src-IP-Address}' \
                                   ORDER BY id LIMIT 1), 1), \
                         '%{Acct-Session-Id}', \
                         '%{Packet-Src-IP-Address}-%{Acct-Session-Id}-%{User-Name}', \
                         '%{User-Name}', '%{Realm}', \
                         '%{Packet-Src-IP-Address}', '%{NAS-Port}', '%{NAS-Port-Type}', \
                         datetime('now'), \
                         '%{Acct-Authentic}', '%{Connect-Info}', \
                         '%{Called-Station-Id}', '%{Calling-Station-Id}', \
                         '%{Service-Type}', '%{Framed-Protocol}', \
                         '%{Framed-IP-Address}', '%{Framed-IPv6-Address}', \
                         '%{Framed-IPv6-Prefix}', '%{Framed-Interface-Id}', \
                         '%{Delegated-IPv6-Prefix}')"
            }

            interim-update {
                # R10.6: WHERE يطابِق Packet-Src-IP-Address نفسه الذي
                # كُتب وقت INSERT (Start)، كي يصل لنفس الصفّ.
                #
                # R11 — GIGAWORDS: عدّاد الأوكتيتات في RADIUS 32-بت ويلتفّ كل
                # 2^32 = 4.294 جيجابايت. المايكروتيك (وأي NAS مطابق لـ RFC
                # 2869) يُرسل الفائض في Acct-Input-Gigawords / Acct-Output-
                # Gigawords. القيمة الصحيحة = (gigawords << 32) + octets. كنّا
                # نخزّن الـ octets الخام فقط، فأيّ جلسة > 4.29 جيجا تُبتَر
                # (mod 4.29GB). نطوي الآن الـ gigawords داخل العمود نفسه
                # (acctinputoctets عمود INTEGER في SQLite = 64-بت، يتّسع
                # لإكسابايت). الـ `%{%{Attr}:-0}` يُعطي 0 للـ NAS التي لا
                # تُرسل gigawords، فلا انكسار.
                query = "\
                    UPDATE ${....acct_table1} SET \
                        acctupdatetime  = datetime('now'), \
                        acctinterval    = '%{Acct-Interim-Interval}', \
                        acctsessiontime = '%{Acct-Session-Time}', \
                        acctinputoctets = ('%{%{Acct-Input-Gigawords}:-0}' * 4294967296) + '%{%{Acct-Input-Octets}:-0}', \
                        acctoutputoctets= ('%{%{Acct-Output-Gigawords}:-0}' * 4294967296) + '%{%{Acct-Output-Octets}:-0}', \
                        framedipaddress = '%{Framed-IP-Address}' \
                    WHERE acctsessionid = '%{Acct-Session-Id}' \
                      AND nasipaddress  = '%{Packet-Src-IP-Address}' \
                      AND acctstoptime IS NULL"
            }

            stop {
                # R11 — GIGAWORDS: انظر التعليق في interim-update. نطوي
                # الـ gigawords في القيمة النهائية أيضًا كي لا تُبتَر الجلسة
                # الثقيلة عند إغلاقها.
                query = "\
                    UPDATE ${....acct_table1} SET \
                        acctstoptime       = datetime('now'), \
                        acctsessiontime    = '%{Acct-Session-Time}', \
                        acctinputoctets    = ('%{%{Acct-Input-Gigawords}:-0}' * 4294967296) + '%{%{Acct-Input-Octets}:-0}', \
                        acctoutputoctets   = ('%{%{Acct-Output-Gigawords}:-0}' * 4294967296) + '%{%{Acct-Output-Octets}:-0}', \
                        acctterminatecause = '%{Acct-Terminate-Cause}', \
                        connectinfo_stop   = '%{Connect-Info}' \
                    WHERE acctsessionid = '%{Acct-Session-Id}' \
                      AND nasipaddress  = '%{Packet-Src-IP-Address}' \
                      AND acctstoptime IS NULL"
            }
        }
    }

    # ـ post-auth query محفوظة لو احتجناها مستقبلاً — حاليًا الـ
    # sites-enabled/default لا يستدعي sql في post-auth (Flask يكتب
    # radpostauth داخليًا عبر policy_engine._log_attempt).
    post-auth {
        # MT1 — نفس اشتقاق الجهة المستخدم في accounting start أعلاه.
        query = "\
            INSERT INTO radpostauth \
                (tenant_id, username, pass, reply, authdate, class, nas) \
            VALUES \
                (COALESCE((SELECT tenant_id FROM nas_devices \
                           WHERE address = '%{Packet-Src-IP-Address}' \
                             AND enabled = 1 AND deleted_at IS NULL \
                           ORDER BY id LIMIT 1), \
                          (SELECT tenant_id FROM nas \
                           WHERE nasname = '%{Packet-Src-IP-Address}' \
                           ORDER BY id LIMIT 1), 1), \
                 '%{User-Name}', '%{User-Password}', '%{reply:Packet-Type}', \
                 datetime('now'), '', '%{NAS-IP-Address}')"
    }
}
