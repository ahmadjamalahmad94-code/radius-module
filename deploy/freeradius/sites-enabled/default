# ─────────────────────────────────────────────────────────────────────────────
# default — virtual server يعالج auth/acct.
# المعمارية المعتمدة (REST-only auth):
#   authorize:   rest → /api/v1/internal/auth (Flask policy_engine يقرّر).
#   authenticate: pap/chap (مُلحق فقط لو rest لم يُحدّد Auth-Type).
#   accounting:  detail + sql (radacct فقط — مُعزَّل عن auth).
#   post-auth:   rest فقط → /api/v1/internal/postauth (webhooks).
#                ملحوظة: لا نستدعي sql هنا. Flask يكتب radpostauth داخليًا.
#                السبب: rlm_sql_sqlite "Hit reconnection limit" كان يحوّل
#                الـ Accept إلى Reject لأن post-auth section يفشل (rcode=fail).
#                المعمارية الصحيحة: SQL مفيد للـ accounting reporting فقط،
#                وكل قرارات الـ auth تذهب لـ Flask عبر REST.
#
# تنبيه: نتجنّب modules لا تُشحن مع freeradius/freeradius-server:3.2.5 image:
#   - rlm_acct_unique  → FreeRADIUS يولّد Acct-Unique-Session-Id داخليًا.
#   - rlm_realm (suffix) → لا نحتاج realm parsing.
#   - rlm_attr_filter   → لا نحتاج فلترة attrs الرفض.
# ─────────────────────────────────────────────────────────────────────────────

server default {

listen {
    type   = auth
    ipaddr = *
    port   = 0
    limit {
        max_connections = 16
        lifetime        = 0
        idle_timeout    = 30
    }
}

listen {
    ipaddr = *
    port   = 0
    type   = acct
    limit {}
}

# ـ ملاحظة هامة: rlm_rest في FR 3.2.5 لا يدعم إضافة custom HTTP headers ـ
# (لا عبر `header = ...` في mods-enabled/rest، ولا عبر REST-HTTP-Header
#  attribute — هذا الأخير ميزة FR 4.x فقط). الحلّ المعتمد: نمرّر السرّ
# داخل JSON body كحقل _internal_secret (انظر mods-enabled/rest الـ data
# block) و Flask يقبل السرّ من الـ header أو الـ body.

# ─ AUTHORIZATION (قرار الوصول) ─
authorize {
    preprocess

    # ─ مسار نفق الإدارة v6 (SSTP/PPTP) — حسابات rtr-* فقط ─
    # هذه ليست مشتركين؛ تُصادَق بـMSCHAP-v2 من radcheck محليًّا (Cleartext/
    # NT-Password) عبر sql ثم mschap، وتتجاوز محرّك سياسة REST كليًّا. مسار
    # المشترك أدناه (else) لم يتغيّر إطلاقًا.
    if (&User-Name =~ /^rtr-/) {
        # sql يحمّل radcheck → control:Cleartext-Password / NT-Password
        # (+ radreply: Framed-IP-Address) لهذا المستخدم.
        sql
        if (notfound) {
            reject
        }
        # mschap يضبط Auth-Type := MS-CHAP لو وُجدت MS-CHAP attributes
        # (SSTP/PPTP دائمًا تُرسلها). لو لم تُرسَل (نادر) نسقط لـPAP.
        mschap
        if (!control:Auth-Type) {
            update control { Auth-Type := PAP }
        }
    }
    else {
        # نطبّق rest module: يستدعي /api/v1/internal/auth ويُرجع:
        #   control:Auth-Type := Accept | Reject
        #   reply:<attr> := <value>...
        rest

        # لو HobeRadius رفض → نُعيد Reject مع الـ Reply-Message
        if (control:Auth-Type == "Reject") {
            reject
        }

        # لو HobeRadius وافق ولم يحدّد طريقة auth → نستخدم pap لمقارنة كلمة المرور
        # (rest يُرجع Cleartext-Password في reply attrs لو وافق)
        if (!control:Auth-Type) {
            update control { Auth-Type := PAP }
        }

        pap
    }
}

# ─ AUTHENTICATION (مقارنة كلمة المرور بعد قرار الوصول) ─
authenticate {
    Auth-Type PAP {
        pap
    }
    Auth-Type CHAP {
        chap
    }
    # MSCHAP-v1/v2 — نفق الإدارة v6 (SSTP/PPTP rtr-*). الـmschap module
    # يتحقّق من MS-CHAP2-Response مقابل NT/Cleartext-Password المحمّلة من sql.
    Auth-Type MS-CHAP {
        mschap
    }
}

# ─ PREACCT — تحضير acct request ─
preacct {
    preprocess
}

# ─ ACCOUNTING — كتابة لـ radacct + الردّ بـ Accounting-Response ─
# ـ سياسة عدم منع الردّ ـ
# المشكلة التي رأيناها سابقاً: لمّا `sql` يفشل (لسبب أيًّا كان — locking
# على SQLite، schema mismatch، نقص permissions)، الـ accounting section
# يُرجع rcode=fail، فـ FreeRADIUS لا يُرسل Accounting-Response. ينتج عن
# ذلك على MikroTik: "RADIUS accounting request not sent: no response".
#
# الإصلاح: نُجبر sql على أن يكون "غير حاجز" — أي rcode فشل/رفض/invalid
# يُعامَل بـ priority=1 (تابِع) بدل return. ثم نُلحق module `ok` في
# نهاية الـ section ليضمن rcode=ok نهائي → FR يُرسل Accounting-Response.
#
# لاحظ: `detail` (file-based log في /var/log/freeradius/radacct/) أُزيل
# بعد R3 لأن sql radacct أصبح canonical (R2 أصلح schema، R3 أوقف
# الـ writes المكرَّرة من accounting_puller). الـ file-based detail يُكرّر
# الـ data و يستهلك disk I/O. لو أردت إعادته للـ debugging مؤقتًا، أضف
# سطر `detail` قبل `sql`.
accounting {
    sql {
        fail     = 1
        reject   = 1
        invalid  = 1
        notfound = 1
    }
    ok
}

# ─ POST-AUTH (بعد قرار FreeRADIUS) ─
# ـ rest فقط: نستدعي Flask للـ logging/webhooks. Flask يكتب radpostauth داخليًا
# عبر policy_engine._log_attempt. لا sql هنا كي لا يفشل قبول auth بسبب
# rlm_sql_sqlite reconnection issues.
post-auth {
    # ـ السرّ يُمرَّر في JSON body (انظر mods-enabled/rest) ـ
    rest

    Post-Auth-Type REJECT {
        # ـ noop: Flask سجّل الرفض بالفعل في policy_engine._log_attempt ـ
        # نتجنّب sql هنا لنفس سبب post-auth أعلاه.
        ok
    }
}
}
