# HobeRadius — نسخ هذا الملف إلى .env واملأ القيم.

# ────────────────── Flask ──────────────────
FLASK_SECRET=change-me-to-32-random-bytes-please
FLASK_DEBUG=0

# ────────────────── DB ──────────────────
HOBERADIUS_DB_PATH=/app/instance/hoberadius.db

# ────────────────── seed ──────────────────
# الإنتاج: أبقِ =1 (بلا بيانات تجريبيّة). النسخة الجديدة تُنشئ تلقائيًّا مدير
# دخول افتراضيًّا: المستخدم «admin» وكلمة المرور «123456789» — غيّرها فورًا بعد
# أوّل دخول. (لبيئة تجربة/عرض بالبيانات الوهميّة اضبطها = فارغة.)
# لتخصيص بيانات المدير الافتراضيّ:
#   HOBERADIUS_BOOTSTRAP_ADMIN_USER=admin
#   HOBERADIUS_BOOTSTRAP_ADMIN_PASS=123456789
HOBERADIUS_NO_SEED=1

# ────────────────── workers ──────────────────
# اضبط على 1 لإيقاف workers (للديباغ فقط)
HOBERADIUS_NO_WORKER=
HOBERADIUS_ACCT_INTERVAL_SEC=30

# ────────────────── API ──────────────────
# توكنات env (CSV). الأفضل: استخدم DB tokens عبر UI.
HOBERADIUS_API_TOKENS=

# ────────────────── MikroTik (اختياري — env بديل عن UI) ──────────────────
# لو ضبطت هذه، يُنشأ MT config افتراضي للـ tenant=1 عند الإقلاع.
# MIKROTIK_HOST=10.0.0.1
# MIKROTIK_PORT=8728
# MIKROTIK_USER=admin
# MIKROTIK_PASSWORD=
# MIKROTIK_TLS=0

# ────────────────── gunicorn ──────────────────
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

# ────────────────── FreeRADIUS ──────────────────
# 1) secret مشترك بين الـ FreeRADIUS container و HobeRadius — يُحقن في
#    Header X-Internal-Secret عند استدعاء /api/v1/internal/auth و postauth.
#    لازم يكون نفس القيمة على الطرفين. **مطلوب في الإنتاج**.
#    توليد سريع:  openssl rand -hex 32
HOBERADIUS_INTERNAL_SECRET=

# 2) RADIUS shared secret لكل NAS — *ليس* env. يُدار من DB عبر جدول nas
#    (يُحرَّر من /admin/radius/devices). FreeRADIUS يقرأه عبر mods-enabled/sql.
#    deploy/freeradius/clients.conf يحوي افتراضيًا client testing123 على
#    127.0.0.1 + شبكة docker الداخلية — احذفه/غيّره في prod.

# 3) مستوى debug لـ FreeRADIUS — فارغ في الإنتاج، "-X" لديباغ verbose.
FREERADIUS_DEBUG_LEVEL=

# ────────────────── accel-ppp / نفق الإدارة v6 (SSTP/PPTP) ──────────────────
# نفق إدارة راوترات RouterOS 6 (لا WireGuard فيها): يخدمه accel-ppp على
# المضيف (SSTP :443 / PPTP :1723) ويصادق حسابات rtr-* مقابل FreeRADIUS المحلّي.
# كل القيم لها افتراضات مدمجة في المولّد (deploy/accel-ppp/accel_conf_gen.py)
# فالنفق يعمل بدونها؛ اضبطها هنا فقط لو أردت تجاوز الافتراضات. المُثبِّت
# deploy/accel-ppp/install-accel-selfsigned.sh يقرأ هذا الملف (--env-file).
#
# ملاحظة حرجة: السرّ التالي هو **المصدر الوحيد** لسرّ RADIUS المشترك بين
# accel و عميل FreeRADIUS (accel-local-sstp). المُثبِّت يولّد ملف العميل
# بنفس القيمة فلا ينحرفان. اتركه فارغًا لاستخدام الافتراض (accel-local-secret)
# على الطرفين، أو اضبطه على سرّ قوي:  openssl rand -hex 32
# HOBERADIUS_ACCEL_RADIUS_SECRET=

# عنوان FreeRADIUS الذي يصادق عليه accel (الافتراض: localhost على نفس الـ VPS).
# HOBERADIUS_ACCEL_RADIUS_SERVER=127.0.0.1

# مجمّع عناوين النفق + عنوان البوّابة بداخله (يُربط على lo + systemd unit).
# الافتراض 10.50.0.0/24 + أوّل عنوان (10.50.0.1). لا يصطدم بمجمّع WireGuard.
# HOBERADIUS_MGMT_TUNNEL_POOL=10.50.0.0/24
# HOBERADIUS_MGMT_TUNNEL_SERVER_IP=10.50.0.1

# منفذ مستمع SSTP. الافتراض 443. ⚠️ يصطدم مع نشر nginx لـ:443 في
# docker-compose — راجع deploy/RUNBOOK.md §نفق SSTP قبل تشغيل المُثبِّت
# (إمّا تحرير المنفذ من nginx، أو ضبط منفذ SSTP مختلف هنا مثل 4443).
# HOBERADIUS_ACCEL_SSTP_PORT=443
# ملاحظة: سكربتات «اتصال البيانات» تقرأ هذا المفتاح نفسه، فإزاحة المستمع
# تنسحب تلقائيًّا على عميل SSTP المولَّد للراوتر (لا منفذ مثبَّت في الكود).

# منفذ المضيف الذي تُنشر عليه اللوحة بـHTTPS (الجانب الداخليّ يبقى 8443).
# الافتراض 8443:8443 = لا تغيير. للحصول على رابطٍ بلا منفذ (https://<domain>):
#   1) أزِح SSTP: HOBERADIUS_ACCEL_SSTP_PORT=4443 ثمّ أعِد تشغيل مُثبِّت accel،
#   2) ثمّ اضبط: HOBERADIUS_PANEL_HTTPS_PUBLISH=443:8443 وأعد إنشاء حاوية nginx.
# ⚠️ الترتيب مُلزِم — لو ما زال accel يملك :443 فحاوية nginx لن تُقلع.
# HOBERADIUS_PANEL_HTTPS_PUBLISH=8443:8443

# مسارا شهادة/مفتاح SSTP الموقّعَين ذاتيًّا (يولّدهما المُثبِّت لو غابا).
# HOBERADIUS_ACCEL_SSL_PEMFILE=/etc/accel-ppp/accel-selfsigned.pem
# HOBERADIUS_ACCEL_SSL_KEYFILE=/etc/accel-ppp/accel-selfsigned.key

# ────────────────── WireGuard (Phase M auto-provisioning) ──────────────────
# هذه القيم يقرأها الـ container لمعرفة وضع الـ tunnel (يكتب peer files
# في /etc/hoberadius/wg-peers.d/ — لا يلمس wg0.conf أبدًا).
# اضبطها مرة واحدة لكل VPS بعد ما تجهّز wg0.

# مفتاح السيرفر العام (الراوترات تحتاجه في endpoint). شغل:
#   sudo cat /etc/wireguard/server_public.key
HOBERADIUS_WG_SERVER_PUBKEY=

# عنوان الـ VPS من منظور الراوتر (عادة الـ public IP) + UDP listen port.
# مثلاً: 187.77.70.18:51820
HOBERADIUS_WG_SERVER_ENDPOINT=

# subnet الـ tunnel وعنوان السيرفر بداخله. الافتراضي 10.10.0.0/24 + 10.10.0.1
# (تتطابق مع deploy/wg-reload.sh — لو غيّرت subnet لازم تغيّر الـ wg0.conf كمان).
HOBERADIUS_WG_SUBNET=10.10.0.0/24
HOBERADIUS_WG_SERVER_IP=10.10.0.1

# اسم الـ interface — افتراضي wg0. تغييره يحتاج تعديل wg-reload.sh كذلك.
HOBERADIUS_WG_INTERFACE=wg0

# ────────────────── NPC Remote-tunnel (Phase 5R) ──────────────────
# عنوان الـ VPS الذي يراه العملاء — يُستخدم في بناء روابط الوصول عن بُعد
# (Winbox / SSH / WebFig / API) من خارج الشبكة عبر nginx-stream forwarder
# على المنافذ 51000-51199.
#
# لو فاضي، الـ Setup Wizard «اتصال عن بُعد» يرجع للـ WG tunnel IP،
# والذي يصلح فقط للفنّيين على نفس الـ VPN. اضبطه على الـ public IP
# (أو hostname) للـ VPS عشان الروابط تشتغل من أي مكان على الإنترنت.
#
# مثال: 187.77.70.18  أو  hoberadius.example.com
HOBERADIUS_PUBLIC_HOST=

# ───────────── مهلة فتح API المايكروتيك ─────────────
# 🔴 الافتراض في الكود 3 ثوانٍ — يكفي لراوترٍ على شبكةٍ محلّيّة، ويَقصر على
#    راوترٍ خلف نفقٍ بعيد (تأخير 80–90 م.ث). وحين تتجاوزه وميضةُ تأخيرٍ يُعلَن
#    الراوترُ «غير قابل للوصول»، و**تُخفى كلّ جلساته من «المتصلون الآن»**
#    وأصحابُها متّصلون. مُشاهَدٌ على الإنتاج: 529 إنذارًا كاذبًا و13 جلسةً
#    مخفيّة، بينما ping ‏0٪ فقد وزمنُ الفتح الحقيقيّ 0.33–0.70 ثانية.
# ⚠️ ارفعها لأيّ نشرٍ تكون راوتراتُه خلف WireGuard/SSTP عبر الإنترنت.
HOBERADIUS_MT_CONNECT_TIMEOUT_SEC=8

# ────────────────── timezone ──────────────────
TZ=Asia/Amman
