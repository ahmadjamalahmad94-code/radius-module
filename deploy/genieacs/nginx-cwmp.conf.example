# نقطة CWMP العامّة للراوترات (TR-069) — تُدمَج في إعداد Nginx للعميل.
# الراوترات تتّصل بـ https://acs.<subdomain>/  → يُمرَّر داخليًّا إلى genieacs-cwmp.
#
# وثائق MikroTik: HTTPS إلزاميّ في الإنتاج. ضع شهادة العميل (Let's Encrypt) هنا.
# لا تُمرِّر NBI (7557) ولا Mongo إطلاقًا — CWMP فقط.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name acs.CLIENT_SUBDOMAIN.hoberadius.com;   # عدّله لكل عميل

    ssl_certificate     /etc/letsencrypt/live/acs.CLIENT_SUBDOMAIN.hoberadius.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/acs.CLIENT_SUBDOMAIN.hoberadius.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # حدود آمنة: جسم Inform صغير، مهلة معقولة، منع الإساءة.
    client_max_body_size 2m;
    proxy_read_timeout 30s;

    location / {
        proxy_pass http://127.0.0.1:7547;      # genieacs-cwmp
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ملاحظة أمان: لا تضع Cloudflare Proxy (البرتقاليّ) أمام CWMP قبل التأكّد من
# توافق الراوترات؛ استخدم DNS-only للنطاق الفرعيّ للـ ACS.
