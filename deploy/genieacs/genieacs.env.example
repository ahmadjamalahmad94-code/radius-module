# قالب بيئة وحدة TR-069 لنسخة عميل. انسخه واضبط القيم، ثم مرّره للتطبيق و/أو
# لأمر docker compose الخاصّ بـ GenieACS.

# ── تفعيل الوحدة في تطبيق HobeRadius ──
HOBERADIUS_TR069_ENABLED=1
# عنوان NBI كما يراه التطبيق (اسم الحاوية على شبكة hrnet، أو 127.0.0.1).
HOBERADIUS_GENIEACS_NBI_URL=http://hoberadius-genieacs:7557
# عنوان CWMP العامّ الذي يُوضَع في الراوترات (خلف Nginx/HTTPS).
HOBERADIUS_GENIEACS_CWMP_URL=https://acs.clientN.hoberadius.com/
# مهلة نداء NBI (ثوانٍ) ومدّة صلاحية رمز التسجيل (ساعات) — اختياريّة.
HOBERADIUS_GENIEACS_NBI_TIMEOUT=6
HOBERADIUS_TR069_ENROLL_TTL_H=72
# دورة العامل الخلفيّ (ثوانٍ).
HOBERADIUS_TR069_INTERVAL_SEC=30

# ── GenieACS نفسه ──
# سرّ توقيع واجهة GenieACS — فريد وقويّ لكل عميل: openssl rand -hex 24
GENIEACS_UI_JWT_SECRET=CHANGE-ME-PER-CUSTOMER
# صورة GenieACS (اتركها للافتراضي ما لم يلزم تثبيت إصدار).
# GENIEACS_IMAGE=drumsergio/genieacs:1.2.16.0

# موارد موصى بها: ذاكرة ≥ 4GB على VPS يشغّل GenieACS + Mongo إلى جانب HobeRadius.
